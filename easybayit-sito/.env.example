# Variabili d'ambiente di Easybayit (copiare in .env per lo sviluppo locale; su Vercel: Project → Settings → Environment Variables).
# NON committare mai il file .env con valori reali.

# --- Moduli (contatto / proposta / guida) → /api/lead/ ---
# Senza RESEND_API_KEY l'endpoint lavora in MODALITÀ MOCK (nessun invio, solo log).
RESEND_API_KEY=
LEAD_TO_EMAIL=            # es. info@easybayit.co.il  [DA CONFERMARE]
LEAD_FROM_EMAIL=          # es. "Easybayit <sito@easybayit.co.il>" (dominio verificato su Resend) [DA CONFERMARE]
SITE_URL=                 # es. https://www.easybayit.co.il — usato in BUILD (canonical, hreflang, sitemap, robots) e a runtime (controllo Origin) [DA CONFERMARE]
LEAD_MOCK=                # 1 = forza la modalità mock

# --- Stima affitto ---
RENT_COMPARABLES_PROVIDER=demo   # demo | yad2 (solo con accordo/licenza ufficiale)
# Credenziali del fornitore di comparabili: da definire con l’accordo (oggi il provider yad2 è uno stub). [DA VERIFICARE]

# --- Build ---
DEPLOY_TARGET=            # vercel per forzare l'adattatore Vercel (su Vercel è automatico)
# Flag SOLO per test locale: in produzione devono restare VUOTI / non impostati.
SHOW_TEST_LOGOS=
SHOW_DRAFTS=
SHOW_SERVICE_METRICS=
SHOW_TRUST_SECURITY=
