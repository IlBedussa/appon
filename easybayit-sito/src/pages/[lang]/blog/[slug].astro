---
// Articoli del blog in ebraico/francese/italiano: /<lang>/blog/<slug>/ (le bozze solo con SHOW_DRAFTS=1).
import Article from '../../../components/blog/Article.astro';
import { getPosts, type Post } from '../../../lib/blog';
export async function getStaticPaths() {
  const posts = (await getPosts()).filter((p) => p.data.lang !== 'en');
  return posts.map((post) => ({ params: { lang: post.data.lang, slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---
<Article post={post} />
