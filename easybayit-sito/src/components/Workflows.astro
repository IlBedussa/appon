---
/*
 * Diagrammi dei flussi (vetrina principale): manutenzione via WhatsApp e flusso denaro/dati.
 * - Loghi dei servizi: pacchetto npm `simple-icons` (CC0), colori ufficiali del brand.
 * - Servizi senza icona in simple-icons (Morning/Green Invoice, Grow, Banca d'Israele): badge testuale.
 * - Loghi delle ISTITUZIONI (Lamas/CBS, Rashut HaMisim, Rashut HaTaagidim, Privacy Protection Authority):
 *   SOLO con SHOW_TEST_LOGOS=1, letti dal disco come data URI (mai in dist/ in una build normale),
 *   con l'etichetta "TEST – remove before publishing". Senza flag: solo etichette testuali neutre.
 * - Didascalia "integrazioni previste / in sviluppo": nessuna partnership implicita.
 * - Animazioni solo CSS; con prefers-reduced-motion restano statiche.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { siWhatsapp, siGmail, siSupabase, siVercel, siGooglecalendar, siDropbox } from 'simple-icons';
import Icon from './Icon.astro';
import { SHOW_TEST_LOGOS } from '../config/flags';
import flows from '../i18n/flows';
import type { Locale } from '../i18n/config';

interface Props { lang: Locale; show?: ('maint' | 'money')[]; dark?: boolean; id?: string }
const { lang, show = ['maint', 'money'], dark = true, id = 'workflows' } = Astro.props;
const f = flows[lang];

type Brand = { kind: 'brand'; name: string; path: string; hex: string };
type Text = { kind: 'text'; name: string; color: string };
type Inst = { kind: 'inst'; name: string; src: string };
type Tag = Brand | Text | Inst;
const brand = (s: { title: string; path: string; hex: string }, name = s.title): Brand => ({ kind: 'brand', name, path: s.path, hex: s.hex });
const WA = brand(siWhatsapp), GM = brand(siGmail), SB = brand(siSupabase), VC = brand(siVercel), GC = brand(siGooglecalendar);
const DS = brand(siDropbox, 'Dropbox Sign');
const MORNING: Text = { kind: 'text', name: f.labels.morning, color: '#00b67a' };
const GROW: Text = { kind: 'text', name: f.labels.grow, color: '#7c3aed' };
const BOI: Text = { kind: 'text', name: f.labels.boi, color: '#1e3a8a' };

// Loghi istituzionali: solo a flag acceso; altrimenti etichetta testuale (o niente per ICA/PPA).
const logoDir = join(process.cwd(), 'test-assets', 'authority-logos');
const uri = (file: string, mime: string) => `data:${mime};base64,${readFileSync(join(logoDir, file)).toString('base64')}`;
const inst = (file: string, mime: string, name: string, fallback: string | null): Tag | null =>
  SHOW_TEST_LOGOS ? { kind: 'inst', name, src: uri(file, mime) } : fallback ? { kind: 'text', name: fallback, color: '#334155' } : null;
const CBS = inst('central-bureau-of-statistics.png', 'image/png', 'Central Bureau of Statistics', f.labels.cbs);
const ITA = inst('israel-tax-authority.svg', 'image/svg+xml', 'Israel Tax Authority', f.labels.ita);
const ICA = inst('israel-corporations-authority.png', 'image/png', 'Israel Corporations Authority', f.labels.ica);
const PPA = inst('privacy-protection-authority.svg', 'image/svg+xml', 'Privacy Protection Authority', f.labels.ppa);

type Node = { icon: string; main?: Brand; tags: (Tag | null)[] };
const maint: Node[] = [
  { icon: 'user', tags: [WA] },
  { icon: 'chat', main: WA, tags: [WA] },
  { icon: 'device', tags: [SB, VC] },
  { icon: 'tool', main: GC, tags: [GC] },
  { icon: 'check', tags: [GM, DS] },
  { icon: 'doc', tags: [MORNING, ITA] },
  { icon: 'wallet', tags: [BOI, GM] },
];
const money: Node[] = [
  { icon: 'shield', tags: [ICA] },
  { icon: 'chart', tags: [CBS] },
  { icon: 'doc', main: DS, tags: [DS] },
  { icon: 'wallet', tags: [GROW] },
  { icon: 'globe', tags: [BOI] },
  { icon: 'paperclip', tags: [ITA, MORNING] },
  { icon: 'lock', tags: [PPA, SB] },
];
const sets = { maint: { nodes: maint, text: f.maint }, money: { nodes: money, text: f.money } };
const hasInst = SHOW_TEST_LOGOS;
---
<section class:list={['section', 'wf-sec', { 'wf-sec--dark': dark }]} id={id} aria-labelledby={`${id}-t`}>
  <div class="container">
    <div class="section-head wf-head">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2 id={`${id}-t`}>{f.title}</h2>
      <p>{f.lead}</p>
    </div>

    {show.map((k) => (
      <div class="wf-board" data-reveal>
        <p class="wf-board__label"><span class="wf-live" aria-hidden="true"></span>{f.tabs[k]}</p>
        <ol class:list={['wf', `wf--${sets[k].nodes.length}`]}>
          {sets[k].nodes.map((n, i) => (
            <li class="wf-node" style={`--i:${i}; --n:${sets[k].nodes.length}`}>
              <div class="wf-node__top">
                <span class="wf-icon" style={n.main ? `--b:#${n.main.hex}` : undefined}>
                  {n.main
                    ? <svg viewBox="0 0 24 24" role="img" aria-label={n.main.name}><path d={n.main.path} /></svg>
                    : <Icon name={(n.icon === 'chat' ? 'quote' : n.icon) as never} />}
                </span>
                <span class="wf-step tnum">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3>{sets[k].text[i].t}</h3>
              <p>{sets[k].text[i].d}</p>
              <ul class="wf-tags">
                {(n.tags.filter(Boolean) as Tag[]).map((tg) => (
                  <li class:list={['wf-tag', `wf-tag--${tg.kind}`]} title={tg.name}>
                    {tg.kind === 'brand' && <><svg viewBox="0 0 24 24" aria-hidden="true" style={`fill:#${tg.hex === '000000' ? '0b1324' : tg.hex}`}><path d={tg.path} /></svg><span>{tg.name}</span></>}
                    {tg.kind === 'text' && <><i style={`background:${tg.color}`} aria-hidden="true"></i><span>{tg.name}</span></>}
                    {tg.kind === 'inst' && <img src={tg.src} alt={tg.name} loading="lazy" decoding="async" />}
                  </li>
                ))}
              </ul>
              {i < sets[k].nodes.length - 1 && <span class="wf-link" aria-hidden="true"><span class="wf-dot"></span></span>}
            </li>
          ))}
        </ol>
      </div>
    ))}

    <p class="wf-caption"><Icon name="info" /> {f.planned}</p>
    {hasInst && <p class="wf-test" lang="en" dir="ltr">⚠ {f.testMarker} — institution logos (Corporations Authority, CBS, Tax Authority, Privacy Protection Authority)</p>}
  </div>
</section>

<style>
  .wf-sec { position: relative; overflow: hidden; }
  .wf-sec--dark {
    background:
      radial-gradient(50rem 26rem at 10% 0%, rgb(26 79 214 / .35), transparent 60%),
      radial-gradient(40rem 24rem at 100% 100%, rgb(94 234 212 / .16), transparent 60%),
      #0a1122;
    color: #c9d3e6;
  }
  .wf-sec--dark::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image: linear-gradient(rgb(255 255 255 / .04) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / .04) 1px, transparent 1px);
    background-size: 40px 40px; mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }
  .wf-sec .container { position: relative; }
  .wf-sec--dark h2 { color: #fff; }
  .wf-sec--dark .wf-head p { color: #aab6cc; }
  .wf-sec--dark .eyebrow { color: var(--c-accent); background: rgb(94 234 212 / .1); border-color: rgb(94 234 212 / .3); }

  .wf-board {
    border-radius: var(--r-xl); padding: var(--sp-5); margin-block-end: var(--sp-5);
    background: linear-gradient(180deg, rgb(255 255 255 / .06), rgb(255 255 255 / .02));
    border: 1px solid rgb(255 255 255 / .1); box-shadow: 0 30px 60px rgb(0 0 0 / .25), inset 0 1px 0 rgb(255 255 255 / .08);
    backdrop-filter: blur(6px);
  }
  .wf-sec:not(.wf-sec--dark) .wf-board { background: #fff; border-color: var(--c-line); box-shadow: var(--sh-lg); }
  @media (min-width: 1024px) { .wf-board { padding: var(--sp-6); } }
  .wf-board__label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 var(--sp-5); font-size: var(--fs-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: rgb(255 255 255 / .08); border: 1px solid rgb(255 255 255 / .12); padding: 4px 12px; border-radius: var(--r-pill); }
  :lang(he) .wf-board__label { letter-spacing: 0; }
  .wf-sec:not(.wf-sec--dark) .wf-board__label { color: var(--c-ink); background: var(--c-surface); border-color: var(--c-line); }
  .wf-live { inline-size: 8px; block-size: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgb(34 197 94 / .6); animation: wf-ping 2s infinite; }

  .wf { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-5); }
  @media (min-width: 1100px) {
    .wf { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: var(--sp-4); }
    .wf--7 { --cols: 7; } .wf--6 { --cols: 6; }
  }
  .wf-node {
    position: relative; display: flex; flex-direction: column; gap: 6px;
    background: rgb(10 17 34 / .55); border: 1px solid rgb(255 255 255 / .1); border-radius: var(--r-lg);
    padding: var(--sp-4); min-inline-size: 0;
    animation: wf-glow calc(var(--n) * 1.2s) calc(var(--i) * 1.2s) infinite;
  }
  .wf-sec:not(.wf-sec--dark) .wf-node { background: var(--c-surface); border-color: var(--c-line); }
  .wf-node__top { display: flex; justify-content: space-between; align-items: center; margin-block-end: 4px; }
  .wf-icon {
    --b: var(--c-primary);
    display: grid; place-items: center; inline-size: 46px; block-size: 46px; border-radius: 14px;
    background: var(--b); color: #fff; box-shadow: 0 8px 20px color-mix(in srgb, var(--b) 45%, transparent);
  }
  .wf-icon svg { inline-size: 24px; block-size: 24px; fill: #fff; }
  .wf-icon :global(.icon) { inline-size: 22px; block-size: 22px; }
  .wf-step { font-size: var(--fs-xs); font-weight: 800; color: rgb(255 255 255 / .35); letter-spacing: .05em; }
  .wf-sec:not(.wf-sec--dark) .wf-step { color: var(--c-line-strong); }
  .wf-node h3 { font-size: var(--fs-sm); margin: 0; color: #fff; line-height: 1.3; }
  .wf-sec:not(.wf-sec--dark) .wf-node h3 { color: var(--c-ink); }
  .wf-node p { margin: 0; font-size: var(--fs-xs); line-height: 1.5; color: #9fadc6; flex: 1; }
  .wf-sec:not(.wf-sec--dark) .wf-node p { color: var(--c-muted); }
  .wf-tags { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 5px; }
  .wf-tag {
    display: inline-flex; align-items: center; gap: 5px; max-inline-size: 100%;
    background: #fff; color: #0b1324; border-radius: 8px; padding: 3px 7px; font-size: 11px; font-weight: 600; line-height: 1.2;
    box-shadow: 0 1px 2px rgb(0 0 0 / .2);
  }
  .wf-tag span { overflow-wrap: anywhere; }
  .wf-tag svg { inline-size: 14px; block-size: 14px; flex: none; }
  .wf-tag i { inline-size: 8px; block-size: 8px; border-radius: 2px; flex: none; }
  /* Loghi istituzionali (solo SHOW_TEST_LOGOS): piccoli, allineati agli altri badge, bordo rosso tratteggiato = TEST. */
  .wf-tag--inst { padding: 3px 6px; outline: 1.5px dashed #dc2626; outline-offset: 1px; }
  .wf-tag--inst img { block-size: 24px; inline-size: auto; max-inline-size: 110px; object-fit: contain; display: block; }

  /* Connettori animati: verticali su mobile, orizzontali da 1100px. */
  .wf-link { position: absolute; pointer-events: none; }
  .wf-link {
    inset-inline-start: 38px; inset-block-start: 100%; inline-size: 2px; block-size: var(--sp-5);
    background: repeating-linear-gradient(180deg, var(--c-accent) 0 6px, transparent 6px 12px); background-size: 2px 24px;
    animation: wf-flow-v 1s linear infinite; opacity: .8;
  }
  .wf-dot { position: absolute; inset-inline-start: -4px; inline-size: 10px; block-size: 10px; border-radius: 50%; background: #fff; box-shadow: 0 0 12px 3px var(--c-accent); animation: wf-move-v 1.6s ease-in-out infinite; animation-delay: calc(var(--i) * .25s); }
  @media (min-width: 1100px) {
    .wf-link {
      inset-block-start: 38px; inset-inline-start: 100%; block-size: 2px; inline-size: var(--sp-4);
      background: repeating-linear-gradient(90deg, var(--c-accent) 0 6px, transparent 6px 12px); background-size: 24px 2px;
      animation-name: wf-flow-h; z-index: 1;
    }
    :global([dir='rtl']) .wf-link { animation-direction: reverse; }
    .wf-dot { inset-block-start: -4px; inset-inline-start: auto; animation-name: wf-move-h; }
    :global([dir='rtl']) .wf-dot { animation-name: wf-move-h-rtl; }
  }
  .wf-sec:not(.wf-sec--dark) .wf-link { --c-accent: var(--c-primary); }

  .wf-caption { display: flex; gap: 8px; align-items: flex-start; margin: var(--sp-4) 0 0; font-size: var(--fs-xs); color: #94a3b8; max-inline-size: 80ch; }
  .wf-sec:not(.wf-sec--dark) .wf-caption { color: var(--c-muted); }
  .wf-caption :global(.icon) { flex: none; inline-size: 16px; block-size: 16px; }
  .wf-test { display: inline-block; margin: var(--sp-3) 0 0; background: #dc2626; color: #fff; font-size: var(--fs-xs); font-weight: 700; padding: 3px 12px; border-radius: var(--r-pill); }

  @keyframes wf-flow-v { to { background-position: 0 24px; } }
  @keyframes wf-flow-h { to { background-position: 24px 0; } }
  @keyframes wf-move-v { 0% { inset-block-start: -5px; opacity: 0; } 20%, 80% { opacity: 1; } 100% { inset-block-start: calc(100% - 5px); opacity: 0; } }
  @keyframes wf-move-h { 0% { left: -5px; opacity: 0; } 20%, 80% { opacity: 1; } 100% { left: calc(100% - 5px); opacity: 0; } }
  @keyframes wf-move-h-rtl { 0% { right: -5px; opacity: 0; } 20%, 80% { opacity: 1; } 100% { right: calc(100% - 5px); opacity: 0; } }
  @keyframes wf-glow { 0%, 12% { border-color: rgb(94 234 212 / .7); box-shadow: 0 0 0 1px rgb(94 234 212 / .35), 0 12px 30px rgb(94 234 212 / .15); } 20%, 100% { border-color: rgb(255 255 255 / .1); box-shadow: none; } }
  @keyframes wf-ping { 0% { box-shadow: 0 0 0 0 rgb(34 197 94 / .6); } 100% { box-shadow: 0 0 0 10px rgb(34 197 94 / 0); } }

  @media (prefers-reduced-motion: reduce) {
    .wf-node, .wf-link, .wf-live { animation: none; }
    .wf-dot { display: none; }
  }
</style>
