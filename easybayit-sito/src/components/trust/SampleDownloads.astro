---
// Scheda "scarica l'esempio": anteprima della prima pagina + PDF nelle 4 lingue (lingua corrente in evidenza).
import TIcon from './TIcon.astro';
import { tt, locales, langMeta, type Locale } from '../../i18n/config';
interface Props { lang: Locale; file: 'health-report' | 'inspection-report'; preview: string[]; title: string; text: string }
const { lang, file, preview, title, text } = Astro.props;
const x = tt(lang);
const order = [lang, ...locales.filter((l) => l !== lang)];
---
<div class="sdl" data-reveal>
  <div class="sdl__pages" aria-hidden="true">
    {preview.map((src, i) => <img src={src} alt="" width="397" height="562" loading={i ? 'lazy' : 'eager'} decoding="async" style={`--i:${i}`} />)}
    <span class="sdl__ex">{x.common.example}</span>
  </div>
  <div class="sdl__txt">
    <h2>{title}</h2>
    <p>{text}</p>
    <p class="sdl__langs-h">{x.report.langs}</p>
    <ul class="sdl__langs">
      {order.map((l, i) => (
        <li><a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--secondary', 'btn--sm']} href={`/downloads/${file}-example-${l}.pdf`} download hreflang={l} lang={l}>
          <TIcon name="download" /> {langMeta[l].label} <small>PDF</small></a></li>
      ))}
    </ul>
  </div>
</div>
<style>
  .sdl { display: grid; gap: var(--sp-6); align-items: center; padding: var(--sp-6); border-radius: var(--r-xl); border: 1px solid var(--c-line);
    background: radial-gradient(30rem 18rem at 0% 0%, var(--c-primary-50), transparent 70%), #fff; box-shadow: var(--sh-sm); }
  @media (min-width: 860px) { .sdl { grid-template-columns: minmax(260px, 380px) 1fr; } }
  .sdl__pages { position: relative; display: grid; justify-items: center; padding: var(--sp-3) var(--sp-5) var(--sp-5); }
  .sdl__pages img { grid-area: 1 / 1; inline-size: min(100%, 300px); block-size: auto; border-radius: 6px; background: #fff; box-shadow: 0 20px 40px -18px rgb(11 19 36 / .45), 0 0 0 1px var(--c-line);
    transform: translate(calc(var(--i) * 26px), calc(var(--i) * 18px)) rotate(calc(var(--i) * 3deg)); z-index: calc(10 - var(--i)); }
  :global([dir='rtl']) .sdl__pages img { transform: translate(calc(var(--i) * -26px), calc(var(--i) * 18px)) rotate(calc(var(--i) * -3deg)); }
  .sdl__ex { position: absolute; inset-block-start: 0; inset-inline-start: 6px; z-index: 20; font-size: 11px; font-weight: 800; letter-spacing: .08em; color: #b45309; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 999px; padding: 2px 10px; }
  .sdl h2 { font-size: var(--fs-xl); }
  .sdl__txt > p { color: var(--c-ink-2); }
  .sdl__langs-h { font-size: var(--fs-xs); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--c-muted) !important; margin: var(--sp-5) 0 var(--sp-2); }
  :lang(he) .sdl__langs-h { letter-spacing: 0; }
  .sdl__langs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .sdl__langs small { font-weight: 500; opacity: .7; font-size: 11px; }
</style>
