---
// "Drive di gestione" interattivo (esempio). Componente riutilizzabile: riceve un DriveModel
// (cartelle, sottocartelle, file con registro attività) e i testi; nessun dato è cablato qui.
// - Senza JS: tutte le cartelle restano visibili in sequenza e ogni file è un link al PDF/immagine.
// - Con JS: navigazione a cartelle, ricerca, vista elenco/griglia, anteprima in <dialog> con
//   pagine, dettagli, motivo della scelta (preventivi) e registro attività; ← → Esc da tastiera.
// - Link diretti: #drive=<cartella>&file=<id> (usati anche per gli screenshot).
import { statSync } from 'node:fs';
import { join } from 'node:path';
import TIcon from './TIcon.astro';
import T from '../T.astro';
import { DRIVE_FOLDERS, driveAssets, type DriveModel, type DriveFile } from '../../lib/trust/drive-model';
import { tt, langMeta, type Locale } from '../../i18n/config';
interface Props { lang: Locale; model: DriveModel; id?: string }
const { lang, model, id = 'drive' } = Astro.props;
const x = tt(lang);
const d = x.drive;
const intl = langMeta[lang].intl;
const TZ = 'Asia/Jerusalem';
const fmtDate = (iso: string) => new Intl.DateTimeFormat(intl, { day: 'numeric', month: 'short', year: 'numeric', timeZone: TZ }).format(new Date(iso.length === 10 ? iso + 'T12:00:00+03:00' : iso));
const fmtDateTime = (iso: string) => new Intl.DateTimeFormat(intl, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: TZ }).format(new Date(iso));
const fmtShort = (iso: string) => new Intl.DateTimeFormat(intl, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: TZ }).format(new Date(iso));
const nf = new Intl.NumberFormat(intl, { maximumFractionDigits: 0 });
const ils = (v: number) => new Intl.NumberFormat(intl, { style: 'currency', currency: 'ILS', currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(v);
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
const size = (p: string) => { try { return statSync(join(process.cwd(), 'public', p)).size; } catch { return null; } };
const fmtSize = (b: number | null) => (b == null ? '—' : b < 1024 * 1024 ? `${nf.format(Math.max(1, Math.round(b / 1024)))} KB` : `${new Intl.NumberFormat(intl, { maximumFractionDigits: 1 }).format(b / 1048576)} MB`);
const actText = (a: DriveFile['activity'][number]) => fill(d.actions[a.action], { who: d.who[a.who] });

const files = model.files.map((f) => {
  const a = driveAssets(f, lang);
  const acts = [...f.activity].sort((p, q) => Date.parse(p.at) - Date.parse(q.at));
  const last = acts[acts.length - 1];
  const name = (d.files as Record<string, string>)[f.id] ?? f.id;
  return {
    ...f, name, assets: a, bytes: size(a.file),
    last: last ? `${actText(last)} · ${fmtShort(last.at)}` : '',
    acts: acts.map((e) => ({ text: actText(e), at: fmtDateTime(e.at), action: e.action, who: e.who })),
    why: (d.chosenWhy as Record<string, string>)[f.id] ?? '',
  };
});
type F = (typeof files)[number];
const rootOf = (folder: string) => model.subfolders.find((s) => s.id === folder)?.parent ?? folder;
const inFolder = (fid: string) => files.filter((f) => f.folder === fid);
const deepCount = (fid: string) => files.filter((f) => rootOf(f.folder) === fid).length + model.subfolders.filter((s) => s.parent === fid).length;
const folderName = (fid: string) => (d.folders as Record<string, string>)[fid] ?? (d.sub as Record<string, string>)[model.subfolders.find((s) => s.id === fid)?.titleKey ?? ''] ?? fid;
const tone = (fid: string) => DRIVE_FOLDERS.find((f) => f.id === rootOf(fid))?.tone ?? '#1a4fd6';
const panels = [...DRIVE_FOLDERS.map((f) => f.id as string), ...model.subfolders.map((s) => s.id)];

// Dati per l'anteprima (client)
const client = files.map((f) => ({
  id: f.id, name: f.name, kind: f.kind, folder: f.folder, file: f.assets.file, pages: f.assets.pages, size: fmtSize(f.bytes),
  date: f.kind === 'image' ? fmtDateTime(f.date) : fmtDate(f.date), dateLabel: f.kind === 'image' ? d.taken : d.docDate,
  lang: f.localized ? d.localized : f.original ? d.originals[f.original] : '', chosen: !!f.chosen, why: f.why,
  amount: f.amountIls != null ? ils(f.amountIls) : '', acts: f.acts,
}));
const ui = {
  page: d.page, pages: d.pages, chosen: d.chosen, type: d.type, typePdf: d.typePdf, typeImage: d.typeImage, size: d.colSize, original: d.original,
  amount: d.amount, folder: d.folder, results: d.results, items: d.items, folderNames: Object.fromEntries(panels.map((p) => [p, folderName(p)])), root: d.root,
  parents: Object.fromEntries(model.subfolders.map((s) => [s.id, s.parent])),
};
const fileIcon = (f: F) => (f.kind === 'image' ? 'image' : 'file');
---
<div class="drive" id={id} data-drive data-ui={JSON.stringify(ui)} data-files={JSON.stringify(client)} data-view="list">
  <!-- Barra applicazione -->
  <div class="drive__bar">
    <div class="drive__brand">
      <span class="drive__logo" aria-hidden="true"><TIcon name="folderOpen" /></span>
      <div class="drive__title">
        <p class="drive__app">{d.appName}</p>
        <p class="drive__prop"><TIcon name="home" /> <span>{d.property}</span></p>
      </div>
      <span class="drive__ex" title={x.common.fictional}>{x.common.example}</span>
    </div>
    <div class="drive__tools">
      <label class="drive__search">
        <span class="visually-hidden">{d.search}</span>
        <TIcon name="search" />
        <input type="search" placeholder={d.searchPh} data-search autocomplete="off" />
      </label>
      <div class="drive__views" role="group" aria-label={`${d.viewList} / ${d.viewGrid}`}>
        <button type="button" data-view-btn="list" aria-pressed="true" title={d.viewList}><TIcon name="list" /><span class="visually-hidden">{d.viewList}</span></button>
        <button type="button" data-view-btn="grid" aria-pressed="false" title={d.viewGrid}><TIcon name="grid" /><span class="visually-hidden">{d.viewGrid}</span></button>
      </div>
    </div>
  </div>

  <div class="drive__body">
    <!-- Barra laterale cartelle -->
    <nav class="drive__side" aria-label={d.appName}>
      <ul>
        <li><button type="button" data-go="root" aria-current="true"><TIcon name="grid" /> <span>{d.root}</span></button></li>
        {DRIVE_FOLDERS.map((f) => (
          <li>
            <button type="button" data-go={f.id} style={`--tone:${f.tone}`}>
              <span class="drive__fi"><TIcon name="folder" /></span>
              <span class="drive__fname">{folderName(f.id)}</span>
              <span class="drive__count tnum">{deepCount(f.id)}</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="drive__mirror"><TIcon name="info" /> {d.mirror}</p>
    </nav>

    <div class="drive__main">
      <div class="drive__crumbs" aria-live="polite">
        <button type="button" data-go="root" class="drive__crumb">{d.root}</button>
        <span data-crumbs></span>
        <span class="drive__meta" data-meta></span>
      </div>

      <!-- Radice: schede delle cartelle -->
      <section class="drive__panel" data-panel="root" aria-label={d.root}>
        <ul class="drive__folders">
          {DRIVE_FOLDERS.map((f) => (
            <li>
              <a href={`#drive=${f.id}`} data-go={f.id} class="drive__fcard" style={`--tone:${f.tone}`} aria-label={fill(d.openFolder, { name: folderName(f.id) })}>
                <span class="drive__fcard-ic"><TIcon name={f.icon} /></span>
                <span class="drive__fcard-name">{folderName(f.id)}</span>
                <span class="drive__fcard-hint">{(d.folderHints as Record<string, string>)[f.id]}</span>
                <span class="drive__fcard-n tnum">{fill(d.items, { n: deepCount(f.id) })}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Una sezione per cartella (e sottocartella) -->
      {panels.map((pid) => {
        const subs = model.subfolders.filter((s) => s.parent === pid);
        const list = inFolder(pid);
        return (
          <section class="drive__panel" data-panel={pid} aria-label={folderName(pid)} style={`--tone:${tone(pid)}`}>
            <h3 class="drive__nojs-title">{folderName(pid)}</h3>
            {pid === 'quotes' && <p class="drive__note"><TIcon name="info" /> {d.quotesNote}</p>}
            {subs.length > 0 && (
              <ul class="drive__subs">
                {subs.map((s) => {
                  const q = inFolder(s.id);
                  const ch = q.find((f) => f.chosen);
                  return (
                    <li>
                      <a href={`#drive=${s.id}`} data-go={s.id} class="drive__sub" aria-label={fill(d.openFolder, { name: folderName(s.id) })}>
                        <span class="drive__fi"><TIcon name="folder" /></span>
                        <span class="drive__sub-name">{folderName(s.id)}</span>
                        <span class="drive__sub-quotes">
                          {q.map((f) => <span class:list={['drive__qchip tnum', { 'is-chosen': f.chosen }]}>{f.chosen && <TIcon name="check" />}{ils(f.amountIls ?? 0)}</span>)}
                        </span>
                        {ch && <span class="drive__sub-n">{fill(d.items, { n: q.length })}</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
            {list.length > 0 && (
              <div class="drive__table" role="table" aria-label={folderName(pid)}>
                <div class="drive__row drive__row--head" role="row">
                  <span role="columnheader">{d.colName}</span>
                  <span role="columnheader">{d.colModified}</span>
                  <span role="columnheader">{d.colSize}</span>
                  <span role="columnheader">{d.colActivity}</span>
                </div>
                {list.map((f) => (
                  <a class:list={['drive__row drive__file', { 'is-chosen': f.chosen }]} role="row" href={f.assets.file} data-file={f.id} target="_blank" rel="noopener" aria-label={fill(d.openFile, { name: f.name })} data-name={f.name.toLowerCase()}>
                    <span role="cell" class="drive__cell-name">
                      <span class:list={['drive__thumb', `drive__thumb--${f.kind}`]}>
                        <img src={f.assets.thumb} alt="" loading="lazy" decoding="async" width="120" height={f.kind === 'image' ? 90 : 170} />
                        <span class="drive__ticon"><TIcon name={fileIcon(f)} /></span>
                      </span>
                      <span class="drive__nm">
                        <bdi class="drive__nm-text">{f.name}</bdi>
                        <span class="drive__tags">
                          {f.chosen && <span class="drive__chosen"><TIcon name="checkCircle" /> {d.chosen}</span>}
                          {f.amountIls != null && <span class="drive__amt tnum">{ils(f.amountIls)}</span>}
                          {f.localized && <span class="drive__lang"><TIcon name="lang" /> {langMeta[lang].short}</span>}
                        </span>
                      </span>
                    </span>
                    <span role="cell" class="drive__cell tnum">{f.kind === 'image' ? fmtShort(f.date) : fmtDate(f.date)}</span>
                    <span role="cell" class="drive__cell tnum">{fmtSize(f.bytes)}</span>
                    <span role="cell" class="drive__cell drive__cell-act"><TIcon name="history" /> <span>{f.last}</span></span>
                  </a>
                ))}
              </div>
            )}
          </section>
        );
      })}

      <!-- Risultati di ricerca (riempiti dal JS) -->
      <section class="drive__panel" data-panel="search" hidden>
        <div class="drive__table" data-results></div>
        <p class="drive__empty" data-noresults hidden><TIcon name="search" /> {d.noResults}</p>
      </section>
    </div>
  </div>
  <p class="drive__foot"><TIcon name="shield" /> <span>{x.common.fictional} {d.watermark}</span> <span class="drive__kbd">{d.keyboard}</span></p>

  <!-- Anteprima -->
  <dialog class="dv" data-dialog aria-labelledby={`${id}-dv-title`}>
    <div class="dv__inner">
      <header class="dv__head">
        <span class="dv__ic" data-dv-icon><TIcon name="file" /></span>
        <h3 class="dv__title" id={`${id}-dv-title`}><bdi data-dv-name></bdi></h3>
        <span class="drive__ex">{x.common.example}</span>
        <div class="dv__nav">
          <button type="button" class="dv__btn" data-dv-prev aria-label={x.common.prev}><TIcon name="chevron" class="dv__flip" /></button>
          <span class="dv__pos tnum" dir="ltr" data-dv-pos></span>
          <button type="button" class="dv__btn" data-dv-next aria-label={x.common.next}><TIcon name="chevron" /></button>
          <button type="button" class="dv__btn dv__close" data-dv-close aria-label={d.closePreview}><TIcon name="close" /></button>
        </div>
      </header>
      <div class="dv__body">
        <div class="dv__stage" data-dv-stage tabindex="0" aria-label={d.preview}></div>
        <aside class="dv__panel">
          <div class="dv__chosen" data-dv-chosen hidden>
            <p class="dv__chosen-h"><TIcon name="checkCircle" /> {d.chosen}</p>
            <p data-dv-why></p>
          </div>
          <h4>{d.details}</h4>
          <dl class="dv__dl" data-dv-details></dl>
          <a class="btn btn--primary btn--sm dv__dl-btn" data-dv-download href="#" download><TIcon name="download" /> <span data-dv-dltext>{x.common.downloadPdf}</span></a>
          <h4>{d.activity}</h4>
          <ol class="dv__acts" data-dv-acts></ol>
        </aside>
      </div>
    </div>
  </dialog>
</div>

<script>
  type Act = { text: string; at: string; action: string; who: string };
  type DF = { id: string; name: string; kind: 'pdf' | 'image'; folder: string; file: string; pages: string[]; size: string; date: string; dateLabel: string; lang: string; chosen: boolean; why: string; amount: string; acts: Act[] };
  document.querySelectorAll<HTMLElement>('[data-drive]').forEach((root) => {
    const ui = JSON.parse(root.dataset.ui!);
    const files: DF[] = JSON.parse(root.dataset.files!);
    const byId = new Map(files.map((f) => [f.id, f]));
    const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const crumbs = root.querySelector<HTMLElement>('[data-crumbs]')!;
    const meta = root.querySelector<HTMLElement>('[data-meta]')!;
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const results = root.querySelector<HTMLElement>('[data-results]')!;
    const noRes = root.querySelector<HTMLElement>('[data-noresults]')!;
    let current = 'root';
    let visible: string[] = []; // id dei file nella vista corrente (per ← →)
    root.classList.add('drive--js');

    const rowsIn = (p: HTMLElement) => [...p.querySelectorAll<HTMLElement>('[data-file]')].map((r) => r.dataset.file!);
    const show = (pid: string, push = true) => {
      current = pid;
      panels.forEach((p) => (p.hidden = p.dataset.panel !== pid));
      const top = ui.parents[pid] ?? pid;
      root.querySelectorAll<HTMLButtonElement>('.drive__side [data-go]').forEach((b) => b.setAttribute('aria-current', String(b.dataset.go === top)));
      crumbs.replaceChildren();
      const chain = pid === 'root' || pid === 'search' ? [] : ui.parents[pid] ? [ui.parents[pid], pid] : [pid];
      chain.forEach((c: string, i: number) => {
        const sep = document.createElement('span'); sep.className = 'drive__sep'; sep.textContent = '›'; sep.setAttribute('aria-hidden', 'true');
        const el = document.createElement(i < chain.length - 1 ? 'button' : 'strong');
        el.textContent = ui.folderNames[c];
        if (el instanceof HTMLButtonElement) { el.type = 'button'; el.className = 'drive__crumb'; el.addEventListener('click', () => show(c)); }
        crumbs.append(sep, el);
      });
      const panel = panels.find((p) => p.dataset.panel === pid);
      visible = panel ? rowsIn(panel) : [];
      const n = panel ? panel.querySelectorAll('[data-file], .drive__sub').length : 0;
      meta.textContent = pid === 'root' || pid === 'search' ? '' : fill(ui.items, { n });
      if (push && pid !== 'search') history.replaceState(null, '', pid === 'root' ? location.pathname + location.search : `#drive=${pid}`);
    };

    root.addEventListener('click', (e) => {
      const go = (e.target as HTMLElement).closest<HTMLElement>('[data-go]');
      if (go) { e.preventDefault(); search.value = ''; show(go.dataset.go!); root.querySelector('.drive__main')?.scrollTo?.({ top: 0 }); return; }
      const row = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-file]');
      if (row && !(e as MouseEvent).metaKey && !(e as MouseEvent).ctrlKey) { e.preventDefault(); open(row.dataset.file!); }
    });

    // Vista elenco / griglia
    root.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((b) => b.addEventListener('click', () => {
      root.dataset.view = b.dataset.viewBtn!;
      root.querySelectorAll('[data-view-btn]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    }));

    // Ricerca su tutti i file
    let before = 'root';
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      if (!q) { show(before === 'search' ? 'root' : before); return; }
      if (current !== 'search') before = current;
      results.replaceChildren();
      const hits = [...root.querySelectorAll<HTMLElement>('[data-panel]:not([data-panel=search]) [data-file]')].filter((r) => r.dataset.name!.includes(q));
      hits.forEach((r) => results.append(r.cloneNode(true)));
      noRes.hidden = hits.length > 0;
      show('search', false);
      visible = hits.map((h) => h.dataset.file!);
      meta.textContent = fill(ui.results, { n: hits.length, q: search.value.trim() });
    });

    // ---- Anteprima ----
    const dlg = root.querySelector<HTMLDialogElement>('[data-dialog]')!;
    const $ = <T extends HTMLElement>(s: string) => dlg.querySelector<T>(s)!;
    let openId = '';
    const open = (fid: string) => {
      const f = byId.get(fid); if (!f) return;
      openId = fid;
      $('[data-dv-name]').textContent = f.name;
      $('[data-dv-icon]').dataset.kind = f.kind;
      const stage = $('[data-dv-stage]');
      stage.replaceChildren();
      stage.dataset.kind = f.kind;
      f.pages.forEach((src, i) => {
        const fig = document.createElement('figure');
        const img = document.createElement('img');
        img.src = src; img.alt = f.pages.length > 1 ? `${f.name} — ${fill(ui.page, { n: i + 1, t: f.pages.length })}` : f.name; img.decoding = 'async';
        fig.append(img);
        if (f.pages.length > 1) { const c = document.createElement('figcaption'); c.textContent = fill(ui.page, { n: i + 1, t: f.pages.length }); fig.append(c); }
        stage.append(fig);
      });
      stage.scrollTop = 0;
      const ch = $('[data-dv-chosen]'); ch.hidden = !f.chosen; $('[data-dv-why]').textContent = f.why;
      const dl = $('[data-dv-details]'); dl.replaceChildren();
      const rows: [string, string][] = [[ui.type, f.kind === 'image' ? ui.typeImage : ui.typePdf + (f.pages.length > 1 ? ` · ${fill(ui.pages, { n: f.pages.length })}` : '')], [f.dateLabel, f.date], [ui.size, f.size]];
      if (f.amount) rows.push([ui.amount, f.amount]);
      if (f.lang) rows.push([ui.original, f.lang]);
      rows.push([ui.folder, ui.folderNames[f.folder]]);
      rows.forEach(([k, v]) => { const dt = document.createElement('dt'); dt.textContent = k; const dd = document.createElement('dd'); dd.textContent = v; dl.append(dt, dd); });
      const a = $<HTMLAnchorElement>('[data-dv-download]'); a.href = f.file; a.setAttribute('download', f.name);
      const acts = $('[data-dv-acts]'); acts.replaceChildren();
      f.acts.forEach((ev) => {
        const li = document.createElement('li'); li.dataset.action = ev.action;
        const b = document.createElement('span'); b.className = 'dv__act-t'; b.textContent = ev.text;
        const t = document.createElement('time'); t.textContent = ev.at;
        li.append(b, t); acts.append(li);
      });
      const list = visible.length ? visible : [fid];
      const i = list.indexOf(fid);
      $('[data-dv-pos]').textContent = i >= 0 ? `${i + 1} / ${list.length}` : '';
      $<HTMLButtonElement>('[data-dv-prev]').disabled = i <= 0;
      $<HTMLButtonElement>('[data-dv-next]').disabled = i < 0 || i >= list.length - 1;
      if (!dlg.open) dlg.showModal();
      history.replaceState(null, '', `#drive=${f.folder}&file=${fid}`);
    };
    const step = (dir: number) => { const i = visible.indexOf(openId); const n = visible[i + dir]; if (n) open(n); };
    const close = () => { dlg.close(); };
    dlg.addEventListener('close', () => { history.replaceState(null, '', current === 'root' || current === 'search' ? location.pathname : `#drive=${current}`); root.querySelector<HTMLElement>(`[data-panel="${current}"] [data-file="${openId}"]`)?.focus(); });
    $('[data-dv-close]').addEventListener('click', close);
    $('[data-dv-prev]').addEventListener('click', () => step(document.documentElement.dir === 'rtl' ? -1 : -1));
    $('[data-dv-next]').addEventListener('click', () => step(1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      if (e.key === 'ArrowRight') { e.preventDefault(); step(rtl ? -1 : 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(rtl ? 1 : -1); }
    });

    // Stato iniziale da hash (#drive=cartella&file=id)
    const h = new URLSearchParams(location.hash.slice(1));
    const start = h.get('drive');
    show(start && panels.some((p) => p.dataset.panel === start) ? start : 'root', false);
    if (h.get('file')) open(h.get('file')!);
  });
</script>

<style>
  .drive {
    --tone: var(--c-primary);
    position: relative; border: 1px solid var(--c-line); border-radius: var(--r-xl); background: #fff;
    box-shadow: 0 30px 60px -20px rgb(11 19 36 / .25), 0 12px 24px -12px rgb(11 19 36 / .12); overflow: hidden;
  }
  .drive :global(.icon) { inline-size: 1.15em; block-size: 1.15em; }
  /* Barra */
  .drive__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-3) var(--sp-5); padding: var(--sp-3) var(--sp-5);
    background: linear-gradient(180deg, #fbfcfe, #f3f6fb); border-block-end: 1px solid var(--c-line); }
  .drive__brand { display: flex; align-items: center; gap: var(--sp-3); min-inline-size: 0; }
  .drive__logo { display: grid; place-items: center; inline-size: 40px; block-size: 40px; border-radius: 12px; color: #fff;
    background: linear-gradient(135deg, var(--c-primary), #3b2fd0); box-shadow: 0 6px 14px -6px rgb(26 79 214 / .7); flex: none; }
  .drive__logo :global(.icon) { inline-size: 22px; block-size: 22px; }
  .drive__title { min-inline-size: 0; }
