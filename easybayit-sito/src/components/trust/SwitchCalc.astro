---
// Calcolatore di cambio gestore: costi attuali (inseriti dall'utente) vs livelli di esempio Easybayit.
// Nessuna ipotesi sui concorrenti: tutti i valori "attuali" sono inseriti dall'utente.
import TIcon from './TIcon.astro';
import T from '../T.astro';
import { tiers } from '../../data/pricing';
import { VAT } from '../../data/market';
import { LETTING_MONTHS, EASYBAYIT_MARKUP_PCT, SWITCH_DEFAULTS as D } from '../../data/trust/switching';
import { tt, tx, url, langMeta, type Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = tt(lang);
const s = x.sw;
const o = tx(lang).offer.tiers;
const ctx = {
  intl: langMeta[lang].intl, vat: VAT, tiers, letting: LETTING_MONTHS, markup: EASYBAYIT_MARKUP_PCT,
  names: Object.fromEntries(tiers.map((t) => [t.id, o[t.id].name])), current: s.current,
  save: s.diffSave, more: s.diffMore, same: s.diffSame, b: s.breakdown,
};
const fields: { id: keyof typeof D; label: string; help?: string; min: number; max: number; step: number; unit?: string }[] = [
  { id: 'rent', label: s.rent, min: 0, max: 100000, step: 100, unit: '₪' },
  { id: 'feePct', label: s.feePct, min: 0, max: 30, step: 0.5, unit: '%' },
  { id: 'fixed', label: s.fixed, help: s.fixedHelp, min: 0, max: 10000, step: 10, unit: '₪' },
  { id: 'works', label: s.works, min: 0, max: 200000, step: 100, unit: '₪' },
  { id: 'markup', label: s.markup, help: s.markupHelp, min: 0, max: 50, step: 1, unit: '%' },
  { id: 'letting', label: s.letting, min: 0, max: 3, step: 0.25 },
  { id: 'turnover', label: s.turnover, min: 1, max: 10, step: 1 },
  { id: 'other', label: s.other, help: s.otherHelp, min: 0, max: 50000, step: 50, unit: '₪' },
];
---
<div class="sc" data-switch data-ctx={JSON.stringify(ctx)}>
  <form class="sc__in">
    <p class="sc__exin"><TIcon name="pen" /> {s.calcLead}</p>
    <div class="sc__grid">
      {fields.map((f) => (
        <div class="field">
          <label for={`sw-${f.id}`}>{f.label}</label>
          <div class:list={['sc__num', { 'has-unit': f.unit }]}>
            {f.unit && <span aria-hidden="true">{f.unit}</span>}
            <input class="input tnum" id={`sw-${f.id}`} name={f.id} type="number" inputmode="decimal" min={f.min} max={f.max} step={f.step} value={D[f.id] as number} aria-describedby={f.help ? `sw-${f.id}-h` : undefined} />
          </div>
          {f.help && <small id={`sw-${f.id}-h`} class="sc__help">{f.help}</small>}
        </div>
      ))}
    </div>
    <label class="check"><input type="checkbox" name="vatIncl" checked={D.vatIncl} /> <span>{s.vatIncl}</span></label>
  </form>
  <div class="sc__out" aria-live="polite">
    <h3>{s.resultTitle}</h3>
    <ul class="sc__bars" data-bars>
      <li data-k="current" class="is-current">
        <div class="sc__bar-h"><span class="sc__nm">{s.current}</span><b class="tnum" data-total></b></div>
        <div class="sc__track"><span data-bar></span></div>
        <p class="sc__brk" data-brk></p>
      </li>
      {tiers.map((t) => (
        <li data-k={t.id} class:list={{ 'is-feat': t.featured }}>
          <div class="sc__bar-h"><span class="sc__nm">Easybayit · {o[t.id].name} <span class="example-badge">{x.common.example}</span></span><b class="tnum" data-total></b></div>
          <div class="sc__track"><span data-bar></span></div>
          <p class="sc__diff" data-diff></p>
          <p class="sc__brk" data-brk></p>
        </li>
      ))}
    </ul>
    <p class="sc__note"><TIcon name="info" /> <span><T text={s.exampleNote} /> {s.careNote}</span></p>
    <a class="sc__link" href={url(lang, 'pricing', '#calculator')}>{tx(lang).offer.calc.title} <TIcon name="arrow" /></a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-switch]').forEach((root) => {
    const c = JSON.parse(root.dataset.ctx!);
    const form = root.querySelector('form')!;
    const money = (v: number) => new Intl.NumberFormat(c.intl, { style: 'currency', currency: 'ILS', currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(Math.round(v));
    const num = (n: string) => { const v = Number((form.elements.namedItem(n) as HTMLInputElement).value); return Number.isFinite(v) && v > 0 ? v : 0; };
    const fill = (s: string, v: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? '');
    const render = () => {
      const rent = num('rent'), vatIncl = (form.elements.namedItem('vatIncl') as HTMLInputElement).checked;
      const k = vatIncl ? 1 : 1 + c.vat;
      const turnover = Math.max(1, num('turnover'));
      const cur = {
        fee: (rent * num('feePct') / 100 + num('fixed')) * 12 * k,
        works: num('works') * num('markup') / 100,
        letting: rent * num('letting') * k / turnover,
        other: num('other') * k,
      };
      const rows: Record<string, Record<string, number>> = { current: cur };
      for (const t of c.tiers) {
        const net = t.model === 'fixed' ? t.fixedIls : Math.max(rent * t.pct / 100, t.minIls);
        const lm = c.letting[t.id];
        rows[t.id] = { fee: net * (1 + c.vat) * 12, works: num('works') * c.markup / 100, letting: lm == null ? 0 : rent * lm * (1 + c.vat) / turnover, other: 0 };
      }
      const totals = Object.fromEntries(Object.entries(rows).map(([id, r]) => [id, Object.values(r).reduce((a, b) => a + b, 0)]));
      const max = Math.max(...Object.values(totals), 1);
      for (const [id, r] of Object.entries(rows)) {
        const li = root.querySelector<HTMLElement>(`[data-k="${id}"]`)!;
        li.querySelector('[data-total]')!.textContent = money(totals[id]);
        li.querySelector<HTMLElement>('[data-bar]')!.style.inlineSize = `${Math.max(2, (totals[id] / max) * 100)}%`;
        const parts = [[c.b.fee, r.fee], [c.b.works, r.works], [c.b.letting, r.letting], [c.b.other, r.other]].filter(([, v]) => (v as number) > 0.5);
        li.querySelector('[data-brk]')!.textContent = parts.map(([l, v]) => `${l}: ${money(v as number)}`).join(' · ') + (parts.length ? ` (${c.b.vat})` : '');
        const diff = li.querySelector('[data-diff]');
        if (diff) {
          const dlt = totals.current - totals[id];
          diff.textContent = Math.abs(dlt) < 50 ? c.same : fill(dlt > 0 ? c.save : c.more, { amount: money(Math.abs(dlt)) });
          diff.className = 'sc__diff ' + (Math.abs(dlt) < 50 ? '' : dlt > 0 ? 'is-save' : 'is-more');
        }
      }
    };
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('input', render);
    render();
  });
</script>

<style>
  .sc { display: grid; gap: var(--sp-6); }
  @media (min-width: 1000px) { .sc { grid-template-columns: 1fr 1.05fr; align-items: start; } }
  .sc__in { background: #fff; border: 1px solid var(--c-line); border-radius: var(--r-xl); padding: var(--sp-5); display: grid; gap: var(--sp-4); }
  .sc__exin { display: flex; gap: 8px; align-items: center; margin: 0; font-size: var(--fs-sm); color: var(--c-ink-2); background: var(--c-surface); border-radius: 10px; padding: 8px 12px; }
  .sc__grid { display: grid; gap: var(--sp-4); }
  @media (min-width: 560px) { .sc__grid { grid-template-columns: 1fr 1fr; } }
  .sc__num { position: relative; }
  .sc__num span { position: absolute; inset-inline-start: 12px; inset-block-start: 50%; transform: translateY(-50%); font-weight: 700; color: var(--c-muted); }
  .sc__num.has-unit .input { padding-inline-start: 32px; }
  .sc__num .input { font-weight: 600; }
  .sc__help { color: var(--c-muted); font-size: var(--fs-xs); }
  .sc__out { background: linear-gradient(160deg, #0b1324, #13265c); color: #d6deee; border-radius: var(--r-xl); padding: var(--sp-5) var(--sp-5) var(--sp-4); position: sticky; inset-block-start: calc(var(--header-h) + 16px); }
  .sc__out h3 { color: #fff; font-size: var(--fs-lg); margin-block-end: var(--sp-4); }
  .sc__bars { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); }
  .sc__bars li { display: grid; gap: 6px; padding: var(--sp-3); border-radius: 14px; background: rgb(255 255 255 / .04); border: 1px solid rgb(255 255 255 / .08); }
  .sc__bars li.is-current { background: rgb(255 255 255 / .09); }
  .sc__bars li.is-feat { border-color: rgb(94 234 212 / .45); }
  .sc__bar-h { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3); }
  .sc__nm { font-weight: 600; color: #fff; font-size: var(--fs-sm); display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .sc__nm .example-badge { font-size: 10px; padding: 0 8px; }
  .sc__bar-h b { color: #fff; font-size: var(--fs-lg); white-space: nowrap; }
  .sc__track { block-size: 10px; border-radius: 99px; background: rgb(255 255 255 / .08); overflow: hidden; }
  .sc__track span { display: block; block-size: 100%; border-radius: 99px; background: linear-gradient(90deg, #5b8cff, var(--c-accent)); transition: inline-size .35s ease; }
  :global([dir='rtl']) .sc__track span { background: linear-gradient(-90deg, #5b8cff, var(--c-accent)); }
  .is-current .sc__track span { background: #94a3b8; }
  @media (prefers-reduced-motion: reduce) { .sc__track span { transition: none; } }
  .sc__diff { margin: 0; font-size: var(--fs-sm); font-weight: 700; }
  .sc__diff.is-save { color: #86efac; }
  .sc__diff.is-more { color: #fcd34d; }
  .sc__brk { margin: 0; font-size: 12px; color: #9fb0cc; }
  .sc__note { display: flex; gap: 8px; align-items: flex-start; margin: var(--sp-4) 0 var(--sp-2); font-size: 12px; color: #b8c3d9; }
  .sc__note :global(.icon) { flex: none; margin-block-start: 2px; }
  .sc__note :global(.ph) { background: #3d3410; color: #ffe58a; }
  .sc__link { display: inline-flex; align-items: center; gap: 6px; color: var(--c-accent); font-weight: 600; font-size: var(--fs-sm); text-decoration: none; }
</style>
