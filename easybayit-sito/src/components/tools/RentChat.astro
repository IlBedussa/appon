---
// Widget chat "assistente stima affitto": pulsante flottante + pannello con conversazione guidata.
// Nessun modello AI: è un flusso a passi con risposte rapide; il calcolo è lo stesso della pagina /rent-estimate/.
// Il pannello non è modale (non blocca la pagina); Esc lo chiude e riporta il focus al pulsante.
import Icon from '../Icon.astro';
import { tx, url, langMeta, type Locale } from '../../i18n/config';
import { cityNames, districtNames, israelName, otherCity } from '../../data/cityNames';
import { cityData, rentQ1_2026 } from '../../data/market';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = tx(lang);
const r = x.tools.rent;
const ch = r.chat;
const focus = ['jerusalem', 'beit-shemesh', 'raanana', 'netanya', 'tel-aviv'];
const ctx = {
  intl: langMeta[lang].intl,
  cities: Object.fromEntries(Object.entries(cityNames).map(([k, v]) => [k, { name: v[lang], cbs: v.cbs ?? null, district: cityData[k]?.district ?? null, published: k in rentQ1_2026.cities }])),
  focus,
  otherLabel: otherCity[lang],
  districts: Object.fromEntries(Object.entries(districtNames).map(([k, v]) => [k, v[lang]])),
  other: israelName[lang],
  s: r,
  valuationUrl: url(lang, 'rent', '#rent-lead'),
  pageUrl: url(lang, 'rent'),
};
---
<div class="rchat" data-rchat data-ctx={JSON.stringify(ctx)}>
  <button class="rchat__launcher" type="button" aria-expanded="false" aria-controls="rchat-panel">
    <span class="rchat__dot" aria-hidden="true"></span>
    <Icon name="search" />
    <span>{ch.launcher}</span>
  </button>
  <section class="rchat__panel" id="rchat-panel" role="dialog" aria-modal="false" aria-labelledby="rchat-title" hidden>
    <header class="rchat__head">
      <span class="rchat__avatar" aria-hidden="true"><Icon name="chart" /></span>
      <div>
        <h2 id="rchat-title">{ch.title}</h2>
        <p>{ch.subtitle}</p>
      </div>
      <button class="rchat__close" type="button" aria-label={ch.close}><Icon name="close" /></button>
    </header>
    <div class="rchat__log" role="log" aria-live="polite" aria-relevant="additions"></div>
    <div class="rchat__input"></div>
  </section>
</div>

<script>
  import { requestEstimate, renderResult, fill } from '../../lib/rent/client';
  const root = document.querySelector<HTMLElement>('[data-rchat]');
  if (root) {
    const ctx = JSON.parse(root.dataset.ctx!);
    const s = ctx.s, ch = s.chat;
    const launcher = root.querySelector<HTMLButtonElement>('.rchat__launcher')!;
    const panel = root.querySelector<HTMLElement>('.rchat__panel')!;
    const log = root.querySelector<HTMLElement>('.rchat__log')!;
    const inputArea = root.querySelector<HTMLElement>('.rchat__input')!;
    // Mobile: il pulsante flottante compare solo dopo l'hero (che ha già la CTA "stima affitto"): niente sovrapposizioni nel primo viewport.
    const hero = document.querySelector('.hero');
    if (hero && 'IntersectionObserver' in window) {
      const mq = window.matchMedia('(max-width: 599px)');
      new IntersectionObserver(([e]) => root.classList.toggle('rchat--defer', mq.matches && e.isIntersecting), { threshold: 0.15 }).observe(hero);
    }
    const nf = new Intl.NumberFormat(ctx.intl, { maximumFractionDigits: 1 });
    let answers: Record<string, unknown> = {};
    let started = false;

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => {
      const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e;
    };
    const say = (text: string, who: 'bot' | 'me' = 'bot') => {
      const m = el('div', `rchat__msg rchat__msg--${who}`, text);
      log.append(m); log.scrollTop = log.scrollHeight; return m;
    };
    const focusFirst = () => (inputArea.querySelector<HTMLElement>('input,button'))?.focus();

    // Risposte rapide (pulsanti)
    const quick = (opts: { label: string; value: unknown }[], onPick: (v: unknown, label: string) => void, extra?: HTMLElement) => {
      inputArea.replaceChildren();
      const wrap = el('div', 'rchat__quick');
      opts.forEach((o) => {
        const b = el('button', 'rchat__qbtn', o.label); b.type = 'button';
        b.addEventListener('click', () => { say(o.label, 'me'); onPick(o.value, o.label); });
        wrap.append(b);
      });
      inputArea.append(wrap);
      if (extra) inputArea.append(extra);
      focusFirst();
    };
    // Campo di testo / numero con "Invia" e (opzionale) "Salta"
    const ask = (opts: { type?: string; skip?: boolean; list?: boolean; min?: number; max?: number; label: string }, onAnswer: (v: string) => void) => {
      inputArea.replaceChildren();
      const f = el('form', 'rchat__form');
      const inp = el('input', 'input'); inp.type = opts.type ?? 'text'; inp.placeholder = ch.typeHere; inp.setAttribute('aria-label', opts.label);
      if (opts.min != null) inp.min = String(opts.min);
      if (opts.max != null) inp.max = String(opts.max);
      if (opts.type === 'number') inp.inputMode = 'numeric';
      if (opts.list) {
        const dl = el('datalist'); dl.id = 'rchat-streets'; inp.setAttribute('list', dl.id); f.append(dl);
        let t: number | undefined;
        inp.addEventListener('input', () => {
          clearTimeout(t);
          const code = ctx.cities[answers.city as string]?.cbs; const q = inp.value.trim();
          if (!code || q.length < 2) return;
          t = window.setTimeout(async () => {
            try {
              const data = await (await fetch(`/api/streets/?city=${code}&q=${encodeURIComponent(q)}`)).json();
              dl.replaceChildren(...(data.streets as string[]).map((v) => Object.assign(document.createElement('option'), { value: v })));
            } catch { /* nessun suggerimento */ }
          }, 250);
        });
      }
      const send = el('button', 'btn btn--primary btn--sm', ch.send); send.type = 'submit';
      f.append(inp, send);
      if (opts.skip) {
        const sk = el('button', 'btn btn--secondary btn--sm', ch.skip); sk.type = 'button';
        sk.addEventListener('click', () => { say(ch.skip, 'me'); onAnswer(''); });
        f.append(sk);
      }
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        const v = inp.value.trim();
        if (!v && !opts.skip) { inp.focus(); return; }
        if (opts.type === 'number' && v && !inp.checkValidity()) { inp.focus(); return; }
        say(v || ch.skip, 'me'); onAnswer(v);
      });
      inputArea.append(f); inp.focus();
    };

    const steps = {
      city() {
        say(ch.hello);
        quick([...ctx.focus.map((k: string) => ({ label: ctx.cities[k].name, value: k })), { label: ctx.otherLabel, value: 'other' }], (v) => { answers.city = v; steps.neighborhood(); });
      },
      neighborhood() { say(ch.askNeighborhood); ask({ skip: true, label: s.neighborhood }, (v) => { answers.neighborhood = v; ctx.cities[answers.city as string]?.cbs ? steps.street() : steps.rooms(); }); },
      street() { say(ch.askStreet); ask({ skip: true, list: true, label: s.street }, (v) => { answers.street = v; steps.rooms(); }); },
      rooms() {
        say(ch.askRooms);
        quick([1, 2, 2.5, 3, 3.5, 4, 4.5, 5, 6].map((n) => ({ label: nf.format(n), value: n })), (v) => { answers.rooms = v; steps.sqm(); });
      },
      sqm() { say(ch.askSqm); ask({ type: 'number', skip: true, min: 15, max: 600, label: s.sqm }, (v) => { answers.sqm = v; steps.floor(); }); },
      floor() { say(ch.askFloor); ask({ type: 'number', skip: true, min: -1, max: 60, label: s.floor }, (v) => { answers.floor = v; steps.extras(); }); },
      extras() {
        say(ch.askExtras);
        inputArea.replaceChildren();
        const wrap = el('div', 'rchat__quick');
        const keys = ['elevator', 'parking', 'mamad', 'balcony'];
        keys.forEach((k) => {
          const b = el('button', 'rchat__qbtn', s[k]); b.type = 'button'; b.setAttribute('aria-pressed', 'false');
          b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')));
          b.dataset.k = k; wrap.append(b);
        });
        const done = el('button', 'btn btn--primary btn--sm', ch.done); done.type = 'button';
        done.addEventListener('click', () => {
          const picked = [...wrap.querySelectorAll<HTMLButtonElement>('[aria-pressed=true]')];
          keys.forEach((k) => (answers[k] = picked.some((b) => b.dataset.k === k)));
          say(picked.length ? picked.map((b) => b.textContent).join(', ') : ch.skip, 'me');
          steps.condition();
        });
        inputArea.append(wrap, done); focusFirst();
      },
      condition() {
        say(ch.askCondition);
        quick((['renovated', 'good', 'needs-work'] as const).map((c) => ({ label: s.conditions[c], value: c })), async (v) => { answers.condition = v; await steps.result(); });
      },
      async result() {
        inputArea.replaceChildren();
        const wait = say(ch.thinking); wait.classList.add('rchat__msg--wait');
        const res = await requestEstimate(answers);
        wait.remove();
        if (!res) { say(s.error); steps.restartBtns(); return; }
        const nf0 = new Intl.NumberFormat(ctx.intl, { maximumFractionDigits: 0 });
        const e = res.est;
        say(fill(ch.result, { low: nf0.format(e.low), high: nf0.format(e.high), mid: nf0.format(e.mid), conf: s.conf[e.confidence] }));
        const det = el('details', 'rchat__details');
        const sum = el('summary', '', ch.details);
        const body = el('div', 'rchat__result');
        const c = ctx.cities[answers.city as string];
        body.innerHTML = renderResult(res, s, { intl: ctx.intl, place: c?.name ?? ctx.other, districtName: c?.district ? ctx.districts[c.district] : '' });
        det.append(sum, body);
        const m = el('div', 'rchat__msg rchat__msg--bot rchat__msg--wide'); m.append(det); log.append(m);
        log.scrollTop = log.scrollHeight;
        steps.restartBtns();
      },
      restartBtns() {
        inputArea.replaceChildren();
        const a = el('a', 'btn btn--primary btn--sm', ch.valuation); a.href = ctx.valuationUrl;
        const b = el('button', 'btn btn--secondary btn--sm', ch.restart); b.type = 'button';
        b.addEventListener('click', () => { answers = {}; log.replaceChildren(); steps.city(); });
        const w = el('div', 'rchat__actions'); w.append(a, b); inputArea.append(w); a.focus();
      },
    };

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      launcher.setAttribute('aria-expanded', String(open));
      root.classList.toggle('is-open', open);
      if (open) { if (!started) { started = true; steps.city(); } else focusFirst(); }
      else launcher.focus();
    };
    launcher.addEventListener('click', () => setOpen(panel.hidden));
    root.querySelector('.rchat__close')!.addEventListener('click', () => setOpen(false));
    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.stopPropagation(); setOpen(false); } });
    // Apertura diretta da link con #rent-chat
    document.querySelectorAll('a[href$="#rent-chat"]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); setOpen(true); }));
    if (location.hash === '#rent-chat') setOpen(true);
  }
</script>

<style is:global>
  .rchat { position: fixed; inset-block-end: max(16px, env(safe-area-inset-bottom)); inset-inline-end: 16px; z-index: 70; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .rchat__launcher {
    display: inline-flex; align-items: center; gap: 8px; border: 0; cursor: pointer; font: inherit; font-weight: 700; font-size: var(--fs-sm);
    color: #fff; background: linear-gradient(135deg, var(--c-primary) 0%, #3b2fd0 100%); padding: 12px 18px; border-radius: 999px;
    box-shadow: 0 10px 30px rgb(26 79 214 / .35), 0 2px 6px rgb(0 0 0 / .1); min-block-size: 48px;
  }
  .rchat__launcher:hover { filter: brightness(1.06); }
  .rchat__launcher:focus-visible { outline: 3px solid var(--c-accent); outline-offset: 3px; }
  .rchat__dot { inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--c-accent); box-shadow: 0 0 0 0 rgb(94 234 212 / .7); }
  @media (prefers-reduced-motion: no-preference) { .rchat__dot { animation: rchat-pulse 2s infinite; } }
  @keyframes rchat-pulse { 70% { box-shadow: 0 0 0 8px rgb(94 234 212 / 0); } 100% { box-shadow: 0 0 0 0 rgb(94 234 212 / 0); } }
  .is-open .rchat__launcher { display: none; }
  .rchat--defer:not(.is-open) .rchat__launcher { visibility: hidden; opacity: 0; transform: translateY(12px); }
  @media (prefers-reduced-motion: no-preference) { .rchat__launcher { transition: opacity .2s, transform .2s, visibility .2s; } }
  .rchat__panel {
    order: -1; inline-size: min(400px, calc(100vw - 32px)); block-size: min(620px, calc(100dvh - 32px));
    display: flex; flex-direction: column; background: #fff; border: 1px solid var(--c-line); border-radius: 20px;
    box-shadow: 0 24px 60px rgb(11 19 36 / .25); overflow: hidden;
  }
  .rchat__panel[hidden] { display: none; }
  .rchat__head { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: linear-gradient(135deg, #0b1324, #13265c); color: #d6deee; }
  .rchat__head h2 { font-size: var(--fs-md); color: #fff; margin: 0; }
  .rchat__head p { margin: 0; font-size: var(--fs-xs); }
  .rchat__head > div { flex: 1; min-inline-size: 0; }
  .rchat__avatar { display: grid; place-items: center; inline-size: 38px; block-size: 38px; border-radius: 12px; background: rgb(94 234 212 / .15); color: var(--c-accent); }
  .rchat__close { display: grid; place-items: center; inline-size: 40px; block-size: 40px; border-radius: 10px; border: 1px solid rgb(255 255 255 / .2); background: transparent; color: #fff; cursor: pointer; }
  .rchat__log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 8px; background: var(--c-surface); }
  .rchat__msg { max-inline-size: 85%; padding: 10px 14px; border-radius: 16px; font-size: var(--fs-sm); line-height: 1.45; }
  .rchat__msg--bot { align-self: flex-start; background: #fff; border: 1px solid var(--c-line); border-end-start-radius: 4px; }
  .rchat__msg--me { align-self: flex-end; background: var(--c-primary); color: #fff; border-end-end-radius: 4px; }
  .rchat__msg--wide { max-inline-size: 100%; inline-size: 100%; }
  .rchat__msg--wait { color: var(--c-muted); font-style: italic; }
  .rchat__details summary { cursor: pointer; font-weight: 700; color: var(--c-primary); }
  .rchat__result { margin-block-start: var(--sp-3); }
  .rchat__result .rr-range { font-size: var(--fs-xl); }
  .rchat__input { border-block-start: 1px solid var(--c-line); padding: 12px; display: grid; gap: 8px; background: #fff; }
  .rchat__quick { display: flex; flex-wrap: wrap; gap: 6px; }
  .rchat__qbtn { font: inherit; font-size: var(--fs-sm); padding: 8px 12px; border-radius: 999px; border: 1px solid var(--c-primary-100); background: var(--c-primary-50); color: var(--c-primary-700); cursor: pointer; min-block-size: 40px; }
  .rchat__qbtn:hover { border-color: var(--c-primary); }
  .rchat__qbtn[aria-pressed='true'] { background: var(--c-primary); color: #fff; border-color: var(--c-primary); }
  .rchat__form { display: flex; gap: 6px; }
  .rchat__form .input { flex: 1; min-inline-size: 0; }
  .rchat__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  @media print { .rchat { display: none; } }
</style>
