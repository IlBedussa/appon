---
// Mockup del portale (finestra stilizzata con menu laterale e schede). Solo illustrazione.
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const m = d.mock.portal;
const icons = ['chart', 'doc', 'paperclip', 'tool'];
---
<figure class="mock-portal" aria-label={d.pages.portal.ownerTitle}>
  <div class="pw">
    <div class="pw-bar" aria-hidden="true"><span></span><span></span><span></span><i>Easybayit · {d.ui.comingSoon}</i></div>
    <div class="pw-body">
      <ul class="pw-side">
        {m.items.map((it, i) => <li class:list={{ active: i === 0 }}><Icon name={icons[i]} /> {it}</li>)}
      </ul>
      <div class="pw-main">
        <p class="pw-hello">{m.greeting} <span class="pw-skel" style="inline-size:90px"></span></p>
        <div class="pw-kpis">
          <div class="pw-kpi"><span>{m.balance}</span><b dir="ltr">₪ ••••</b></div>
          <div class="pw-kpi"><span>{d.mock.timeline.title}</span><b><span class="badge badge--soon">{d.mock.timeline.status}</span></b></div>
        </div>
        <div class="pw-lines" aria-hidden="true">
          <span class="pw-skel" style="inline-size:100%"></span>
          <span class="pw-skel" style="inline-size:82%"></span>
          <span class="pw-skel" style="inline-size:64%"></span>
        </div>
      </div>
    </div>
  </div>
  <figcaption>{d.ui.sample}</figcaption>
</figure>
<style>
  .mock-portal { margin: 0; }
  .pw { background: #fff; border: 1px solid var(--c-line); border-radius: var(--r-xl); box-shadow: var(--sh-lg); overflow: hidden; }
  .pw-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--c-surface); border-block-end: 1px solid var(--c-line); }
  .pw-bar span { inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--c-line-strong); }
  .pw-bar i { font-style: normal; font-size: var(--fs-xs); color: var(--c-muted); margin-inline-start: var(--sp-3); }
  .pw-body { display: grid; grid-template-columns: minmax(110px, 0.8fr) 2fr; min-block-size: 220px; }
  .pw-side { list-style: none; padding: var(--sp-3); border-inline-end: 1px solid var(--c-line); display: grid; align-content: start; gap: 4px; font-size: var(--fs-xs); }
  .pw-side li { display: flex; align-items: center; gap: 6px; padding: 8px; border-radius: var(--r-sm); color: var(--c-ink-2); }
  .pw-side li.active { background: var(--c-primary-50); color: var(--c-primary-700); font-weight: 600; }
  .pw-main { padding: var(--sp-4); display: grid; gap: var(--sp-3); align-content: start; }
  .pw-hello { margin: 0; font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .pw-kpis { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2); }
  .pw-kpi { border: 1px solid var(--c-line); border-radius: var(--r-md); padding: var(--sp-3); display: grid; gap: 4px; font-size: var(--fs-xs); color: var(--c-muted); }
  .pw-kpi b { color: var(--c-ink); font-size: var(--fs-md); }
  .pw-lines { display: grid; gap: 8px; }
  .pw-skel { display: inline-block; block-size: 10px; border-radius: 6px; background: var(--c-surface-2); }
  figcaption { text-align: center; font-size: var(--fs-xs); color: var(--c-muted); margin-block-start: var(--sp-3); }
</style>
