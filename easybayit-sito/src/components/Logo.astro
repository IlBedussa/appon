---
// Logo provvisorio (marchio SVG + wordmark). [DA CONFERMARE] Sostituire con il logo definitivo.
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg viewBox="0 0 64 64" width="34" height="34" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="14" fill="#1a4fd6" />
    <path d="M16 30 32 17l16 13v17a3 3 0 0 1-3 3H19a3 3 0 0 1-3-3z" fill="none" stroke="#fff" stroke-width="4" stroke-linejoin="round" />
    <path d="m25 37 5 5 10-10" fill="none" stroke="#5eead4" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="logo__text" lang="en" dir="ltr">Easy<b>bayit</b></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo__text { font-size: 1.3rem; font-weight: 500; color: var(--c-ink); letter-spacing: -0.01em; }
  .logo__text b { font-weight: 700; color: var(--c-primary); }
  .logo--light .logo__text { color: #fff; }
  .logo--light .logo__text b { color: var(--c-accent); }
</style>
