---
import Icon from '../Icon.astro';
import T from '../T.astro';
import PageHero from '../PageHero.astro';
import ServiceCards from '../ServiceCards.astro';
import StatementCard from '../StatementCard.astro';
import CtaBand from '../CtaBand.astro';
import HeroDevices from '../HeroDevices.astro';
import { url, t, type Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const p = d.pages.owners;
---
<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} visualDesktopOnly>
  <div class="btn-row" slot="actions">
    <a class="btn btn--primary" href={url(lang, 'contact')}>{d.ui.cta} <Icon name="arrow" /></a>
    <a class="btn btn--secondary" href={url(lang, 'pricing')}>{d.ui.ctaPricing}</a>
  </div>
  <HeroDevices lang={lang} slot="visual" />
</PageHero>

<section class="section">
  <div class="container"><ServiceCards items={p.services} level={2} /></div>
</section>

<section class="section section--surface">
  <div class="container split">
    <div>
      <h2>{p.monthTitle}</h2>
      <ul class="checklist big">{p.monthPoints.map((x) => <li><Icon name="check" /><span><T text={x} /></span></li>)}</ul>
      <div class="not card card--flat">
        <h3>{p.notTitle}</h3>
        <ul class="checklist checklist--x">{p.notPoints.map((x) => <li><Icon name="x" /><span>{x}</span></li>)}</ul>
      </div>
    </div>
    <StatementCard lang={lang} />
  </div>
</section>

<CtaBand lang={lang} />
<style>
  .big { font-size: var(--fs-lg); gap: var(--sp-3); }
  .not { margin-block-start: var(--sp-6); }
</style>
