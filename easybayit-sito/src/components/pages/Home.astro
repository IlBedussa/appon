---
// Home (fase 3): posizionamento "tecnologia + cura full-service per proprietari all'estero".
import Icon from '../Icon.astro';
import T from '../T.astro';
import CtaBand from '../CtaBand.astro';
import Workflows from '../Workflows.astro';
import BotShowcase from '../BotShowcase.astro';
import TrustSection from '../TrustSection.astro';
import HeroDevices from '../HeroDevices.astro';
import StatementCard from '../StatementCard.astro';
import MaintenanceTimeline from '../MaintenanceTimeline.astro';
import Guarantees from '../offer/Guarantees.astro';
import Sla from '../offer/Sla.astro';
import TrustStrip from '../trust/TrustStrip.astro';
import TierCards from '../offer/TierCards.astro';
import { sources, cityData, type SourceId } from '../../data/market';
import { FALLBACK_RATES } from '../../data/rates';
import { url, tx, langMeta, cityKeys, type Locale, type PageKey } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = tx(lang);
const h = x.home;
const nf = new Intl.NumberFormat(langMeta[lang].intl, { maximumFractionDigits: 0 });
const curFmt = (c: string, v: number) => new Intl.NumberFormat(langMeta[lang].intl, { style: 'currency', currency: c, currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(v);
const demoIls = 12450; // importo FITTIZIO di demo
---
<!-- HERO: primo viewport = per chi (eyebrow) + promessa (h1/lead) + prova (visual + chip verificabili) + 1 CTA primaria e 1 secondaria -->
<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow"><Icon name="globe" /> {h.eyebrow}</p>
      <h1>{h.h1a} <span class="hero__accent">{h.h1b}</span></h1>
      <p class="hero__lead">{h.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={url(lang, 'rent')}>{h.ctaPrimary} <Icon name="arrow" /></a>
        <a class="btn btn--secondary" href={url(lang, 'pledge') + '#example-drive'}><Icon name="eye" /> {h.ctaSecondary}</a>
      </div>
      <!-- Prova: la società registrata su una riga propria (layout stabile in tutte le lingue, niente CLS da a-capo variabili) -->
      <a class="hero__reg" href="#verify"><Icon name="shield" /> <T text={h.chips[0]} /></a>
      <ul class="hero__chips">
        {h.chips.slice(1).map((c) => <li><Icon name="check" /> <T text={c} /></li>)}
      </ul>
    </div>
    <HeroDevices lang={lang} />
  </div>
</section>

<!-- SEGMENTI -->
<section class="section" id="segments">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><Icon name="globe" /> {h.segmentsEyebrow}</p>
      <h2>{h.segmentsTitle}</h2>
      <p>{h.segmentsLead}</p>
    </div>
    <div class="tabs" data-tabs data-reveal>
      <div class="tabs__list" role="tablist" aria-label={h.segmentsTitle}>
        {h.segments.map((s, i) => (
          <button role="tab" type="button" id={`seg-tab-${s.id}`} aria-controls={`seg-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
        ))}
      </div>
      {h.segments.map((s, i) => (
        <div class="tabs__panel segp" role="tabpanel" id={`seg-${s.id}`} aria-labelledby={`seg-tab-${s.id}`} tabindex="0" data-hide={i > 0 ? '' : undefined}>
          <h3>{s.title}</h3>
          <ul class="checklist">{s.points.map((p) => <li><Icon name="check" /><span><T text={p} /></span></li>)}</ul>
          <a class="segp__link" href={url(lang, s.link as PageKey)}>{x.common.learnMore}<span class="visually-hidden">: {s.title}</span> <Icon name="arrow" /></a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PILASTRI -->
<section class="section section--surface">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><Icon name="shield" /> {h.pillarsEyebrow}</p>
      <h2>{h.pillarsTitle}</h2>
    </div>
    <div class="grid grid--3">
      {h.pillars.map((p, i) => (
        <article class="card pillar" data-reveal style={`transition-delay:${i * 80}ms`}>
          <span class="icon-badge"><Icon name={p.icon} /></span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- MERCATO: solo dati pubblici con fonte -->
<section class="section market">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><Icon name="chart" /> {h.marketEyebrow}</p>
      <h2>{h.marketTitle}</h2>
      <p>{h.marketLead}</p>
    </div>
    <dl class="stats">
      {h.stats.map((s, i) => {
        const src = sources[s.src as SourceId];
        return (
          <div class="stat" data-reveal style={`transition-delay:${i * 70}ms`}>
            <dt class="stat__label">{s.label}</dt>
            <dd class="stat__value tnum" dir="ltr">{s.value}</dd>
            <dd class="stat__src"><a href={src.url} target="_blank" rel="noopener" lang="en">{x.common.source}: {src.publisher}</a></dd>
          </div>
        );
      })}
    </dl>
  </div>
</section>

<!-- VETRINA PIATTAFORMA -->
<section class="section section--dark showcase">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow eyebrow--dark"><Icon name="device" /> {h.showcaseEyebrow}</p>
      <h2>{h.showcaseTitle}</h2>
      <p>{h.showcaseLead}</p>
    </div>
    <div class="tabs showcase__tabs" data-tabs data-reveal>
      <div class="tabs__list" role="tablist" aria-label={h.showcaseTitle}>
        {h.showcase.map((s, i) => (
          <button role="tab" type="button" id={`sc-tab-${s.id}`} aria-controls={`sc-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
        ))}
      </div>
      {h.showcase.map((s, i) => (
        <div class="tabs__panel sc" role="tabpanel" id={`sc-${s.id}`} aria-labelledby={`sc-tab-${s.id}`} tabindex="0" data-hide={i > 0 ? '' : undefined}>
          <div class="sc__text">
            <span class:list={['badge', s.status === 'live' ? 'badge--ok' : 'badge--soon']}>{s.status === 'live' ? x.common.live : x.common.soon}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="btn btn--primary" href={url(lang, 'demo')}>{x.common.openDemo} <Icon name="arrow" /></a>
          </div>
          <div class="sc__visual">
            {s.id === 'statement' && <StatementCard lang={lang} compact />}
            {s.id === 'approve' && <MaintenanceTimeline lang={lang} />}
            {s.id === 'inspect' && (
              <div class="sc__photos" aria-hidden="true">
                {['', '', '', '', '', ''].map((_, j) => <span style={`--h:${200 + j * 18}`}><Icon name="eye" /></span>)}
              </div>
            )}
            {s.id === 'currency' && (
              <div class="sc__fx">
                <p class="sc__fx-title">{h.mock.netLabel} · <span class="example-badge">{x.common.demoData}</span></p>
                <ul>
                  <li><span>ILS</span><b class="tnum" dir="ltr">₪{nf.format(demoIls)}</b></li>
                  {(['USD', 'EUR', 'GBP'] as const).map((c) => <li><span>{c}</span><b class="tnum" dir="ltr">{curFmt(c, demoIls / FALLBACK_RATES.ilsPer[c])}</b></li>)}
                </ul>
                <p class="sc__fx-note">{x.common.ratesFallback.replace('{date}', FALLBACK_RATES.date)}</p>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<Guarantees lang={lang} />
<Sla lang={lang} />
<TrustStrip lang={lang} />

<!-- PREZZI (anteprima) -->
<section class="section section--surface">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><Icon name="wallet" /> {x.offer.pricingPage.eyebrow}</p>
      <h2>{x.offer.pricingPage.h1}</h2>
      <p>{x.offer.pricingPage.lead}</p>
    </div>
    <TierCards lang={lang} compact />
    <p class="center"><a class="btn btn--secondary" href={url(lang, 'pricing', '#calculator')}>{x.offer.calc.title} <Icon name="arrow" /></a></p>
  </div>
</section>

<!-- STRUMENTI GRATUITI -->
<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><Icon name="search" /> {h.toolsEyebrow}</p>
      <h2>{h.toolsTitle}</h2>
    </div>
    <div class="grid grid--3">
      {h.tools.map((tl, i) => (
        <a class="card card--link tool" href={url(lang, tl.key as PageKey)} data-reveal style={`transition-delay:${i * 70}ms`}>
          <span class="icon-badge icon-badge--teal"><Icon name={tl.icon} /></span>
          <h3>{tl.title}</h3>
          <p>{tl.text}</p>
          <span class="tool__more">{x.common.learnMore} <Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CITTÀ -->
<section class="section section--surface">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><Icon name="pin" /> {h.citiesEyebrow}</p>
      <h2>{h.citiesTitle}</h2>
      <p><T text={h.citiesLead} /></p>
    </div>
    <ul class="cities">
      {cityKeys.map((k, i) => (
        <li data-reveal style={`transition-delay:${i * 60}ms`}>
          <a href={url(lang, `city-${k}` as PageKey)}>
            <span class="cities__name">{x.cities.items[k].name}</span>
            <span class="cities__rent">{cityData[k].rent ? <><b class="tnum" dir="ltr">₪{nf.format(cityData[k].rent!)}</b> <small>{x.common.perMonth}</small></> : <small>{x.cities.notPublished}</small>}</span>
            <Icon name="arrow" />
          </a>
        </li>
      ))}
    </ul>
    <p class="cities__src"><a href={sources.cbsRentQ1_2026.url} target="_blank" rel="noopener">{x.cities.avgRent} — {sources.cbsRentQ1_2026.publisher}</a></p>
  </div>
</section>

<BotShowcase lang={lang} />

<Workflows lang={lang} />

<TrustSection lang={lang} />
<CtaBand lang={lang} />

<script>
  // Schede accessibili (WAI-ARIA tabs): frecce, Home/End. Senza JS tutti i pannelli restano visibili.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    root.classList.add('tabs--js');
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; panels[j].hidden = i !== j; });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const rtl = document.documentElement.dir === 'rtl';
        const next = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 } as Record<string, number>;
        if (e.key in next) { e.preventDefault(); select((i + next[e.key] + tabs.length) % tabs.length, true); }
        if (e.key === 'Home') { e.preventDefault(); select(0, true); }
        if (e.key === 'End') { e.preventDefault(); select(tabs.length - 1, true); }
      });
    });
    select(0);
  });
</script>

<style>
  .hero { position: relative; overflow: hidden; padding-block: var(--sp-5) var(--sp-6); border-block-end: 1px solid var(--c-line);
    background: radial-gradient(60rem 30rem at 85% -10%, #e3ebff, transparent 60%), radial-gradient(40rem 26rem at -5% 105%, #dff5f1, transparent 60%), #fff; }
  .hero__glow { position: absolute; inset-inline-end: -10%; inset-block-start: 4rem; /* px fissi: con % si spostava al caricamento del font (CLS) */ inline-size: 520px; block-size: 520px; border-radius: 50%;
    background: radial-gradient(circle, rgb(91 140 255 / .18), transparent 65%); filter: blur(10px); pointer-events: none; }
  @media (min-width: 1024px) { .hero { padding-block: var(--sp-7) var(--sp-8); } }
  .hero__grid { position: relative; display: grid; gap: var(--sp-4); align-items: center; }
  @media (min-width: 1024px) { .hero__grid { grid-template-columns: 1.15fr 1fr; gap: var(--sp-6); } }
  .hero .eyebrow { margin-block-end: var(--sp-3); }
  .hero h1 { font-size: clamp(2.125rem, 1.4rem + 2.6vw, 3.5rem); letter-spacing: -0.02em; max-inline-size: 20ch; text-wrap: balance; margin-block-end: var(--sp-3); }
  :lang(he) .hero h1 { letter-spacing: 0; }
  .hero__accent { display: inline-block; background: linear-gradient(100deg, var(--c-primary) 10%, #3b2fd0 50%, var(--c-secondary) 95%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__lead { font-size: var(--fs-md); color: var(--c-ink-2); max-inline-size: 46ch; margin: 0; }
  @media (min-width: 1024px) { .hero__lead { font-size: var(--fs-lg); } }
  .hero .btn-row { margin-block: var(--sp-4) 0; }
  .hero .btn-row :global(.icon) { flex: none; }
  .hero__reg { display: inline-flex; align-items: center; gap: 6px; margin-block-start: var(--sp-4); font-size: var(--fs-sm); font-weight: 700; color: var(--c-ink); text-decoration: none; }
  .hero__reg:hover { text-decoration: underline; }
  .hero__reg :global(.icon) { color: var(--c-success); inline-size: 18px; block-size: 18px; flex: none; }
  .hero__chips { list-style: none; display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-block: var(--sp-2) 0; padding: 0; }
  .hero__chips li { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-xs); font-weight: 600; color: var(--c-ink-2); background: rgb(255 255 255 / .8); border: 1px solid var(--c-line); border-radius: 999px; padding: 4px 12px; }
  .hero__chips :global(.icon) { color: var(--c-success); inline-size: 14px; block-size: 14px; }
  /* Mobile: CTA a tutta larghezza; il mockup resta visibile come "assaggio" nel primo viewport */
  @media (max-width: 599px) {
    .hero .btn-row { display: grid; grid-template-columns: 1fr; gap: var(--sp-2); }
    .hero .btn-row .btn { justify-content: center; min-block-size: 48px; }
  }

  .tabs__list { display: flex; gap: 6px; overflow-x: auto; padding: 4px; scrollbar-width: thin; margin-block-end: var(--sp-5); }
  .tabs__list [role='tab'] { flex: none; font: inherit; font-size: var(--fs-sm); font-weight: 600; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--c-line-strong); background: #fff; color: var(--c-ink-2); cursor: pointer; }
  .tabs__list [role='tab'][aria-selected='true'] { background: var(--c-ink); color: #fff; border-color: var(--c-ink); }
  .tabs__list [role='tab']:focus-visible { outline: 3px solid var(--c-primary-100); outline-offset: 2px; }
  :global(.tabs:not(.tabs--js)) [role='tablist'] { display: none; }
  :global(.tabs:not(.tabs--js)) .tabs__panel + .tabs__panel { margin-block-start: var(--sp-5); }
  .tabs__panel[hidden] { display: none; }
  .segp { padding: var(--sp-6); border-radius: var(--r-xl); background: linear-gradient(135deg, var(--c-primary-50), #fff 60%); border: 1px solid var(--c-line); }
  .segp h3 { font-size: var(--fs-xl); max-inline-size: 30ch; }
  .segp .checklist { max-inline-size: 70ch; }
  .segp__link, .tool__more { display: inline-flex; align-items: center; gap: var(--sp-2); font-weight: 600; text-decoration: none; margin-block-start: var(--sp-4); color: var(--c-primary); }

  .pillar h3 { margin-block-start: var(--sp-3); }
  .pillar p { color: var(--c-ink-2); margin: 0; }

  .stats { display: grid; gap: var(--sp-4); margin: 0; }
  @media (min-width: 720px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stat { display: flex; flex-direction: column; padding: var(--sp-5); border-radius: var(--r-lg); border: 1px solid var(--c-line); background: linear-gradient(180deg, #fff, var(--c-surface)); }
  .stat__value { order: -1; margin: 0; font-size: var(--fs-3xl); font-weight: 700; color: var(--c-primary); line-height: 1; text-align: start; }
  .stat__label { margin: var(--sp-2) 0 var(--sp-3); color: var(--c-ink-2); font-weight: 500; flex: 1; }
  .stat__src { margin: 0; font-size: var(--fs-xs); }
  .stat__src a { color: var(--c-muted); }

  .eyebrow--dark { background: rgb(255 255 255 / .08); border-color: rgb(255 255 255 / .16); color: var(--c-accent); }
  .showcase .tabs__list [role='tab'] { background: rgb(255 255 255 / .06); color: #d6deee; border-color: rgb(255 255 255 / .16); }
  .showcase .tabs__list [role='tab'][aria-selected='true'] { background: #fff; color: var(--c-ink); border-color: #fff; }
  .sc { display: grid; gap: var(--sp-6); align-items: center; padding: var(--sp-6); border-radius: var(--r-xl); background: rgb(255 255 255 / .04); border: 1px solid rgb(255 255 255 / .1); }
  .sc > * { min-inline-size: 0; }
  .sc__text h3 { overflow-wrap: break-word; hyphens: auto; }
  @media (max-width: 599px) { .sc { padding: var(--sp-4); } }
  @media (min-width: 960px) { .sc { grid-template-columns: 1fr 1.1fr; } }
  .sc__text h3 { color: #fff; font-size: var(--fs-xl); margin-block-start: var(--sp-3); }
  .sc__text p { color: #b8c3d9; }
  .sc__visual { color: var(--c-ink); }
  .sc__photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .sc__photos span { aspect-ratio: 4 / 3; border-radius: 10px; display: grid; place-items: center; color: rgb(255 255 255 / .5);
    background: linear-gradient(135deg, hsl(var(--h) 50% 35%), hsl(calc(var(--h) + 30) 45% 25%)); }
  .sc__fx { background: #fff; border-radius: var(--r-lg); padding: var(--sp-5); box-shadow: var(--sh-lg); }
  .sc__fx-title { font-weight: 700; margin: 0 0 var(--sp-3); display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .sc__fx ul { list-style: none; padding: 0; margin: 0; display: grid; }
  .sc__fx li { display: flex; justify-content: space-between; padding: var(--sp-3) 0; border-block-end: 1px solid var(--c-line); }
  .sc__fx li b { font-size: var(--fs-lg); }
  .sc__fx-note { margin: var(--sp-3) 0 0; font-size: var(--fs-xs); color: var(--c-muted); }

  .center { text-align: center; margin-block-start: var(--sp-6); }
  .tool h3 { margin-block-start: var(--sp-3); }
  .tool p { color: var(--c-ink-2); }

  .cities { list-style: none; padding: 0; display: grid; gap: var(--sp-3); }
  @media (min-width: 720px) { .cities { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .cities { grid-template-columns: repeat(5, 1fr); } }
  .cities a { display: grid; gap: var(--sp-2); padding: var(--sp-5); border-radius: var(--r-lg); background: #fff; border: 1px solid var(--c-line); text-decoration: none; color: var(--c-ink); transition: transform .2s, box-shadow .2s; block-size: 100%; }
  .cities a:hover { transform: translateY(-3px); box-shadow: var(--sh-md); }
  .cities__name { font-weight: 700; font-size: var(--fs-lg); }
  .cities__rent b { font-size: var(--fs-lg); color: var(--c-primary); }
  .cities__rent small { color: var(--c-muted); }
  .cities a :global(.icon) { color: var(--c-primary); }
  .cities__src { font-size: var(--fs-xs); margin-block-start: var(--sp-3); }
  .cities__src a { color: var(--c-muted); }
</style>
