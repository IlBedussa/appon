---
// Calcolatore di rendimento netto (tutto nel browser, nessun dato inviato). Con disclaimer fiscale.
import Icon from '../Icon.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import Sources from '../Sources.astro';
import { url, tx, langMeta, type Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = tx(lang);
const y = x.tools.yield;
const num = [
  { id: 'price', label: y.price, value: 2500000, step: 10000 },
  { id: 'rent', label: y.rent, value: 6000, step: 100 },
  { id: 'vacancy', label: y.vacancy, value: 2, step: 1, max: 52 },
  { id: 'mgmt', label: y.mgmt, value: 10, step: 0.5, max: 30 },
  { id: 'arnona', label: y.arnona, value: 0, step: 50 },
  { id: 'vaad', label: y.vaad, value: 0, step: 50 },
  { id: 'maint', label: y.maint, value: 5, step: 0.5, max: 50 },
  { id: 'insurance', label: y.insurance, value: 1500, step: 100 },
  { id: 'other', label: y.other, value: 0, step: 100 },
];
const ctx = { intl: langMeta[lang].intl, vat: 0.18 };
const legend = [
  { k: 'mgmt', label: y.mgmt.split('(')[0].trim() },
  { k: 'fixed', label: `${y.arnona.split('(')[0].trim()} / ${y.vaad.split('(')[0].trim()}` },
  { k: 'maint', label: `${y.maint.split('(')[0].trim()} / ${y.insurance.split('(')[0].trim()}` },
  { k: 'tax', label: y.annualTax },
  { k: 'net', label: y.annualNet },
];
---
<PageHero eyebrow={y.eyebrow} title={y.h1} lead={y.lead} />

<section class="section section--tight">
  <div class="container yc" data-yield data-ctx={JSON.stringify(ctx)}>
    <form class="card yc__form" novalidate onsubmit="return false">
      <h2>{y.inputsTitle}</h2>
      <div class="yc__grid">
        {num.map((n) => (
          <div class="field">
            <label for={`y-${n.id}`}>{n.label}</label>
            <input class="input tnum" id={`y-${n.id}`} name={n.id} type="number" inputmode="decimal" min="0" max={n.max} step={n.step} value={n.value} />
          </div>
        ))}
      </div>
      <label class="yc__check"><input type="checkbox" name="mgmtVat" checked /> {y.mgmtVat}</label>
      <p class="help">{y.ownerPaysHelp}</p>
      <fieldset class="field yc__tax">
        <legend>{y.taxTitle}</legend>
        <label><input type="radio" name="tax" value="none" checked /> {y.taxNone}</label>
        <label><input type="radio" name="tax" value="ten" /> {y.tax10}</label>
        <label><input type="radio" name="tax" value="custom" /> {y.taxCustom}</label>
        <div class="field yc__rate">
          <label for="y-taxRate">{y.taxRate}</label>
          <input class="input tnum" id="y-taxRate" name="taxRate" type="number" min="0" max="60" step="1" value="25" />
        </div>
      </fieldset>
    </form>

    <section class="card yc__out" aria-labelledby="yc-out-title">
      <h2 id="yc-out-title">{y.resultsTitle}</h2>
      <div class="yc__kpis" aria-live="polite">
        <div class="yc__kpi"><span>{y.gross}</span><b class="tnum" data-o="gross">—</b></div>
        <div class="yc__kpi"><span>{y.netPre}</span><b class="tnum" data-o="netPre">—</b></div>
        <div class="yc__kpi yc__kpi--hl"><span>{y.netPost}</span><b class="tnum" data-o="netPost">—</b></div>
      </div>
      <dl class="yc__rows">
        <div><dt>{y.annualRent}</dt><dd class="tnum" data-o="annualRent"></dd></div>
        <div><dt>{y.annualCosts}</dt><dd class="tnum" data-o="annualCosts"></dd></div>
        <div><dt>{y.annualTax}</dt><dd class="tnum" data-o="annualTax"></dd></div>
        <div class="yc__total"><dt>{y.annualNet}</dt><dd class="tnum" data-o="annualNet"></dd></div>
        <div><dt>{y.monthlyNet}</dt><dd class="tnum" data-o="monthlyNet"></dd></div>
      </dl>
      <h3 class="yc__h">{y.breakdown}</h3>
      <div class="yc__bar" aria-hidden="true">{legend.map((l) => <span data-b={l.k}></span>)}</div>
      <ul class="yc__legend">{legend.map((l) => <li><i data-l={l.k}></i>{l.label}</li>)}</ul>
      <p class="rr-disclaimer">{y.disclaimer}</p>
      <a class="btn btn--primary yc__cta" href={url(lang, 'rent')}>{y.cta} <Icon name="arrow" /></a>
    </section>
  </div>
</section>

<section class="section section--surface">
  <div class="container narrow">
    <div class="card card--flat">
      <h2 class="yc__taxh"><Icon name="info" /> {y.taxInfoTitle}</h2>
      <p>{y.taxInfo}</p>
      <p class="help">{x.common.notAdvice}</p>
      <Sources lang={lang} ids={['kolZchutRentTax', 'withholding2513', 'nonResidentManager']} />
    </div>
  </div>
</section>

<CtaBand lang={lang} />

<script>
  document.querySelectorAll<HTMLElement>('[data-yield]').forEach((root) => {
    const ctx = JSON.parse(root.dataset.ctx!);
    const form = root.querySelector('form')!;
    const v = (n: string) => Math.max(0, Number((form.elements.namedItem(n) as HTMLInputElement).value) || 0);
    const money = (n: number) => new Intl.NumberFormat(ctx.intl, { style: 'currency', currency: 'ILS', currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(n);
    const pct = (n: number) => (Number.isFinite(n) ? new Intl.NumberFormat(ctx.intl, { style: 'percent', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n) : '—');
    const set = (k: string, s: string) => { root.querySelector(`[data-o="${k}"]`)!.textContent = s; };
    const rateField = root.querySelector<HTMLElement>('.yc__rate')!;
    const calc = () => {
      const price = v('price'), rent = v('rent');
      const weeks = Math.min(v('vacancy'), 52);
      const annualRent = rent * 12 * ((52 - weeks) / 52);
      const vatOn = (form.elements.namedItem('mgmtVat') as HTMLInputElement).checked;
      const mgmt = annualRent * (v('mgmt') / 100) * (vatOn ? 1 + ctx.vat : 1);
      const fixed = (v('arnona') + v('vaad')) * 12;
      const maint = annualRent * (v('maint') / 100) + v('insurance') + v('other');
      const costs = mgmt + fixed + maint;
      const netPre = annualRent - costs;
      const mode = (form.querySelector<HTMLInputElement>('input[name=tax]:checked')!).value;
      rateField.hidden = mode !== 'custom';
      const tax = mode === 'ten' ? annualRent * 0.1 : mode === 'custom' ? Math.max(netPre, 0) * (v('taxRate') / 100) : 0;
      const net = netPre - tax;
      set('gross', price ? pct((rent * 12) / price) : '—');
      set('netPre', price ? pct(netPre / price) : '—');
      set('netPost', price ? pct(net / price) : '—');
      set('annualRent', money(annualRent)); set('annualCosts', money(costs)); set('annualTax', money(tax));
      set('annualNet', money(net)); set('monthlyNet', money(net / 12));
      const parts: Record<string, number> = { mgmt, fixed, maint, tax, net: Math.max(net, 0) };
      const tot = Object.values(parts).reduce((a, b) => a + b, 0) || 1;
      for (const [k, n] of Object.entries(parts)) root.querySelector<HTMLElement>(`[data-b="${k}"]`)!.style.flexBasis = `${(n / tot) * 100}%`;
    };
    form.addEventListener('input', calc);
    form.addEventListener('change', calc);
    calc();
  });
</script>

<style>
  .yc { display: grid; gap: var(--sp-5); align-items: start; }
  @media (min-width: 1024px) { .yc { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } .yc__out { position: sticky; inset-block-start: calc(var(--header-h) + var(--sp-4)); } }
  .yc h2 { font-size: var(--fs-xl); }
  .yc__grid { display: grid; gap: var(--sp-4); }
  @media (min-width: 560px) { .yc__grid { grid-template-columns: 1fr 1fr; } }
  .yc__check, .yc__tax label { display: flex; gap: var(--sp-2); align-items: center; font-size: var(--fs-sm); margin-block-start: var(--sp-3); }
  .yc__tax { border: 0; padding: 0; margin: var(--sp-4) 0 0; }
  .yc__tax legend { font-weight: 600; font-size: var(--fs-sm); }
  .yc__rate { margin-block-start: var(--sp-3); max-inline-size: 200px; }
  .yc__rate[hidden] { display: none; }
  .help { color: var(--c-muted); font-size: var(--fs-xs); margin: var(--sp-2) 0 0; }
  .yc__kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-2); }
  .yc__kpi { display: grid; gap: 4px; padding: var(--sp-3); border-radius: var(--r-md); background: var(--c-surface); }
  .yc__kpi span { font-size: var(--fs-xs); color: var(--c-muted); font-weight: 600; }
  .yc__kpi b { font-size: var(--fs-xl); color: var(--c-ink); }
  .yc__kpi--hl { background: var(--c-primary-50); }
  .yc__kpi--hl b { color: var(--c-primary-700); }
  .yc__rows { margin: var(--sp-4) 0 0; display: grid; }
  .yc__rows div { display: flex; justify-content: space-between; gap: var(--sp-3); padding: var(--sp-2) 0; border-block-end: 1px solid var(--c-line); }
  .yc__rows dt { color: var(--c-ink-2); }
  .yc__rows dd { margin: 0; font-weight: 600; }
  .yc__total dt, .yc__total dd { font-weight: 700; color: var(--c-ink); }
  .yc__h { font-size: var(--fs-md); margin: var(--sp-5) 0 var(--sp-2); }
  .yc__bar { display: flex; block-size: 14px; border-radius: 99px; overflow: hidden; background: var(--c-surface-2); }
  .yc__bar span { flex: 0 0 0; transition: flex-basis .3s; }
  [data-b='mgmt'], [data-l='mgmt'] { background: #1a4fd6; }
  [data-b='fixed'], [data-l='fixed'] { background: #7c93d8; }
  [data-b='maint'], [data-l='maint'] { background: #94a3b8; }
  [data-b='tax'], [data-l='tax'] { background: #b45309; }
  [data-b='net'], [data-l='net'] { background: #0f766e; }
  .yc__legend { list-style: none; padding: 0; margin: var(--sp-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-4); font-size: var(--fs-xs); color: var(--c-ink-2); }
  .yc__legend li { display: flex; align-items: center; gap: 6px; }
  .yc__legend i { inline-size: 10px; block-size: 10px; border-radius: 3px; display: inline-block; }
  .yc__cta { margin-block-start: var(--sp-5); inline-size: 100%; justify-content: center; }
  .narrow { max-inline-size: 860px; }
  .yc__taxh { display: flex; gap: var(--sp-3); align-items: center; font-size: var(--fs-xl); }
  .yc__taxh :global(.icon) { color: var(--c-primary); }
  @media (max-width: 479px) { .yc__kpis { grid-template-columns: 1fr; } }
</style>
