---
// Pagina per costruttori, agenzie e avvocati: consegna del nuovo, gestione, programma referral (termini segnaposto).
import Icon from '../Icon.astro';
import T from '../T.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import Sources from '../Sources.astro';
import LeadForm from '../LeadForm.astro';
import { url, tx, type Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = tx(lang);
const b = x.b2b;
---
<PageHero eyebrow={b.eyebrow} title={b.h1} lead={b.lead}>
  <div class="btn-row" slot="actions">
    <a class="btn btn--primary" href="#b2b-lead">{b.formTitle} <Icon name="arrow" /></a>
    <a class="btn btn--secondary" href={url(lang, 'demo')}>{x.common.openDemo}</a>
  </div>
  <div class="b2b-stat card" slot="visual" data-reveal>
    <Icon name="chart" />
    <p class="b2b-stat__t">{b.stat}</p>
    <Sources lang={lang} ids={[b.statSrc]} compact />
  </div>
</PageHero>

<section class="section">
  <div class="container">
    <div class="section-head" data-reveal><h2>{b.servicesTitle}</h2></div>
    <ol class="b2b-steps">
      {b.services.map((s, i) => (
        <li class="card" data-reveal style={`transition-delay:${i * 60}ms`}>
          <span class="b2b-steps__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="icon-badge"><Icon name={s.icon} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section section--surface">
  <div class="container split">
    <div class="card" data-reveal>
      <h2>{b.whyTitle}</h2>
      <ul class="checklist">{b.why.map((w) => <li><Icon name="check" /><span>{w}</span></li>)}</ul>
    </div>
    <div class="card referral" data-reveal>
      <h2><Icon name="link" /> {b.referralTitle}</h2>
      <p><T text={b.referralText} /></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <LeadForm lang={lang} id="b2b-lead" title={b.formTitle} text={b.lead} submit={b.submit} context="b2b" extra="b2b" />
  </div>
</section>
<CtaBand lang={lang} />
<style>
  .b2b-stat { display: grid; gap: var(--sp-2); max-inline-size: 420px; }
  .b2b-stat :global(.icon) { inline-size: 36px; block-size: 36px; color: var(--c-primary); }
  .b2b-stat__t { font-size: var(--fs-xl); font-weight: 700; color: var(--c-ink); margin: 0; line-height: 1.3; }
  .b2b-steps { list-style: none; padding: 0; display: grid; gap: var(--sp-4); }
  @media (min-width: 720px) { .b2b-steps { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .b2b-steps { grid-template-columns: repeat(3, 1fr); } }
  .b2b-steps li { position: relative; }
  .b2b-steps__n { position: absolute; inset-block-start: var(--sp-4); inset-inline-end: var(--sp-5); font-weight: 700; color: var(--c-primary-100); font-size: var(--fs-2xl); }
  .b2b-steps h3 { margin-block-start: var(--sp-3); }
  .b2b-steps p { color: var(--c-ink-2); margin: 0; }
  .referral h2 { display: flex; align-items: center; gap: var(--sp-3); }
  .referral h2 :global(.icon) { color: var(--c-primary); }
  .narrow { max-inline-size: 860px; }
</style>
