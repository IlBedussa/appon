---
import Icon from '../Icon.astro';
import T from '../T.astro';
import PageHero from '../PageHero.astro';
import ServiceCards from '../ServiceCards.astro';
import MaintenanceTimeline from '../MaintenanceTimeline.astro';
import Workflows from '../Workflows.astro';
import BotShowcase from '../BotShowcase.astro';
import CtaBand from '../CtaBand.astro';
import { url, t, type Locale } from '../../i18n/config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const p = d.pages.tenants;
---
<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead}>
  <div class="btn-row" slot="actions">
    <a class="btn btn--primary" href={url(lang, 'contact')}>{d.ui.cta} <Icon name="arrow" /></a>
    <a class="btn btn--secondary" href={url(lang, 'portal')}>{d.ui.ctaPortal}</a>
  </div>
  <MaintenanceTimeline lang={lang} slot="visual" current={2} />
</PageHero>

<section class="section">
  <div class="container">
    <div class="notice" role="note">
      <Icon name="alert" />
      <p><strong>{p.urgentTitle}</strong> <T text={p.urgentText} /></p>
    </div>
  </div>
  <div class="container" style="margin-block-start: var(--sp-6)"><ServiceCards items={p.services} level={2} /></div>
</section>

<BotShowcase lang={lang} />

<Workflows lang={lang} show={['maint']} />

<CtaBand lang={lang} />
