---
// Scheda articolo per indice, correlati e hub Legale & Fiscale.
import Icon from '../Icon.astro';
import { tb, langMeta, type Locale } from '../../i18n/config';
import { postUrl, readingMinutes, fmtDate, type Post } from '../../lib/blog';
interface Props { post: Post; lang: Locale; headingLevel?: 'h2' | 'h3' }
const { post, lang, headingLevel = 'h3' } = Astro.props;
const b = tb(lang);
const d = post.data;
const H = headingLevel;
---
<article class="bl-card" data-cluster={d.cluster}>
  <div class="bl-card__top">
    <span class="bl-card__tag">{b.clusters[d.cluster] ?? d.cluster}</span>
    {d.draft && <span class="bl-draft">{b.draftBadge}</span>}
  </div>
  <H class="bl-card__title"><a href={postUrl(post)}>{d.title}</a></H>
  <p class="bl-card__desc">{d.description}</p>
  <p class="bl-card__meta">
    <time datetime={d.pubDate.toISOString().slice(0, 10)}>{fmtDate(d.pubDate, langMeta[lang].intl)}</time>
    <span aria-hidden="true">·</span>
    <span>{b.readTime.replace('{n}', String(readingMinutes(post)))}</span>
  </p>
  <span class="bl-card__more" aria-hidden="true">{b.readMore} <Icon name="arrow" /></span>
</article>
<style>
  .bl-card {
    position: relative; display: flex; flex-direction: column; gap: var(--sp-2);
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--r-lg); padding: var(--sp-5);
    box-shadow: var(--sh-sm); transition: box-shadow .15s, border-color .15s, transform .15s;
  }
  .bl-card:hover { border-color: var(--c-primary-100); box-shadow: var(--sh-md); transform: translateY(-2px); }
  .bl-card:focus-within { box-shadow: var(--focus); }
  @media (prefers-reduced-motion: reduce) { .bl-card, .bl-card:hover { transition: none; transform: none; } }
  .bl-card__top { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .bl-card__tag {
    font-size: var(--fs-xs); font-weight: 600; color: var(--c-secondary); background: var(--c-secondary-50);
    border-radius: var(--r-pill); padding: 2px 10px;
  }
  .bl-card__title { font-size: var(--fs-md); line-height: 1.3; margin: var(--sp-1) 0 0; }
  .bl-card__title a { color: var(--c-ink); text-decoration: none; }
  /* Link "esteso": tutta la scheda è cliccabile mantenendo un solo link accessibile. */
  .bl-card__title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .bl-card__title a:focus-visible { outline: none; }
  .bl-card__desc { margin: 0; font-size: var(--fs-sm); color: var(--c-ink-2); flex: 1; }
  .bl-card__meta { margin: 0; display: flex; gap: 6px; font-size: var(--fs-xs); color: var(--c-muted); }
  .bl-card__more { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-sm); font-weight: 600; color: var(--c-primary); }
  .bl-card__more :global(.icon) { inline-size: 16px; block-size: 16px; }
  :global([dir='rtl']) .bl-card__more :global(.icon) { transform: scaleX(-1); }
</style>
