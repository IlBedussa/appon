---
// Manutenzione (staff): elenco con filtro stato e apertura richiesta per conto di un inquilino/proprietario.
import AppLayout from '../../../layouts/AppLayout.astro';
import Field from '../../../components/Field.astro';
import Csrf from '../../../components/Csrf.astro';
import Icon from '../../../components/Icon.astro';
import Pill from '../../../components/Pill.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import { z, formToObject, optUuid } from '../../../lib/validation';
import { date } from '../../../lib/format';

const { t, supabase, user, intl } = Astro.locals;
const statuses = ['reported', 'in_review', 'quote_pending', 'approved', 'scheduled', 'closed', 'cancelled'] as const;
let error = '';
if (Astro.request.method === 'POST') {
  const p = z.object({ property_id: z.uuid(), tenant_id: optUuid, title: z.string().trim().min(3).max(140), description: z.string().trim().max(4000).default(''), priority: z.enum(['routine', 'urgent']) })
    .safeParse(formToObject(await Astro.request.formData()));
  if (!p.success) error = t.common.invalid;
  else {
    const { data, error: e } = await supabase.from('maintenance_requests').insert({ ...p.data, tenant_id: p.data.tenant_id ?? null, created_by: user!.id }).select('id').single();
    if (e || !data) error = t.common.error;
    else return Astro.redirect(`/admin/maintenance/${data.id}`, 303);
  }
}
const status = Astro.url.searchParams.get('status');
let q = supabase.from('maintenance_requests').select('id, ref, title, source, status, priority, created_at, property:properties(code, name), tenant:tenants(full_name)').order('created_at', { ascending: false }).limit(300);
if (status && (statuses as readonly string[]).includes(status)) q = q.eq('status', status);
const [{ data: rows }, { data: props }, { data: tenants }] = await Promise.all([
  q, supabase.from('properties').select('id, code, name').order('code'), supabase.from('tenants').select('id, full_name').order('full_name'),
]);
---
<AppLayout title={t.maint.title} active="maintenance">
  <details class="create" open={!!error}>
    <summary><Icon name="plus" /> {t.admin.newItem}</summary>
    <div class="create-body">
      {error && <p class="form-status" data-type="error" role="alert">{error}</p>}
      <form method="post" class="form-grid">
        <Csrf />
        <Field name="property_id" label={t.common.property} required options={(props ?? []).map((p) => ({ value: p.id, label: `${p.code} · ${p.name}` }))} />
        <Field name="tenant_id" label={t.common.tenant} options={[{ value: '', label: '—' }, ...(tenants ?? []).map((x) => ({ value: x.id, label: x.full_name }))]} />
        <Field name="title" label={t.tenant.titleLabel} required maxlength={140} />
        <Field name="priority" label={t.tenant.priorityLabel} required options={[{ value: 'routine', label: t.priority.routine }, { value: 'urgent', label: t.priority.urgent }]} />
        <Field name="description" label={t.tenant.descLabel} textarea maxlength={4000} class="span-2" />
        <div class="form-actions span-2"><button class="btn btn--primary btn--sm" type="submit">{t.common.create}</button></div>
      </form>
    </div>
  </details>
  <form method="get" class="filters">
    <div class="field"><label for="st">{t.common.status}</label>
      <select class="select" id="st" name="status"><option value="">{t.common.all}</option>{statuses.map((s) => <option value={s} selected={s === status}>{t.maintStatus[s]}</option>)}</select></div>
    <button class="btn btn--secondary btn--sm" type="submit">{t.common.filter}</button>
  </form>
  <div class="table-wrap dtable dcard flush">
    <table>
      <caption class="visually-hidden">{t.maint.title}</caption>
      <thead><tr><th scope="col">{t.maint.ref}</th><th scope="col">{t.common.property}</th><th scope="col">{t.common.tenant}</th><th scope="col">{t.common.status}</th><th scope="col">{t.common.date}</th></tr></thead>
      <tbody>
        {(rows ?? []).map((r) => (
          <tr>
            <th scope="row"><a href={`/admin/maintenance/${r.id}`}>R-{r.ref} · {r.title}</a> <SourceBadge source={(r as any).source} /> {r.priority === 'urgent' && <Pill tone="urgent">{t.priority.urgent}</Pill>}</th>
            <td>{(r.property as any)?.code}</td>
            <td>{(r.tenant as any)?.full_name ?? '—'}</td>
            <td><Pill tone={r.status === 'quote_pending' ? 'warn' : r.status === 'closed' ? 'ok' : 'info'}>{(t.maintStatus as Record<string, string>)[r.status]}</Pill></td>
            <td class="nowrap">{date(r.created_at, intl)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AppLayout>
