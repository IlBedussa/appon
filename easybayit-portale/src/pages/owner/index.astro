---
// Dashboard proprietario: KPI, grafici e immobili, tutto da dati reali filtrati da RLS.
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import Money from '../../components/Money.astro';
import IncomeChart from '../../components/IncomeChart.astro';
import CashflowChart from '../../components/CashflowChart.astro';
import SlaWidget from '../../components/SlaWidget.astro';
import ExpiriesWidget from '../../components/ExpiriesWidget.astro';
import { fill } from '../../i18n';
import { lastMonths, monthLong, monthStart } from '../../lib/format';

const { t, supabase, intl } = Astro.locals;
const now = new Date();
const curMonth = monthStart(now);
const months = lastMonths(12, now);

const [props, stmts, maint, pays] = await Promise.all([
  supabase.from('properties').select('id, code, name, address, city, rooms, size_sqm, status, asking_rent_ils, leases(id, status, monthly_rent_ils, end_date)').order('code'),
  supabase.from('statements').select('id, period, statement_lines(amount_ils)').gte('period', months[0] + '-01').order('period'),
  supabase.from('maintenance_requests').select('id, status').not('status', 'in', '(closed,cancelled)'),
  supabase.from('payments').select('id, amount_ils, status').eq('kind', 'rent').eq('period', curMonth).neq('status', 'pending'),
]);
const properties = props.data ?? [];
const activeLeases = properties.flatMap((p) => (p.leases ?? []).filter((l) => l.status === 'active'));
const letCount = properties.filter((p) => p.status !== 'vacant').length;
const occupancy = properties.length ? letCount / properties.length : 0;
const rentReceived = (pays.data ?? []).reduce((a, p) => a + Number(p.amount_ils), 0);
const openReq = maint.data?.length ?? 0;
const waiting = (maint.data ?? []).filter((m) => m.status === 'quote_pending').length;

// Serie mensili dai rendiconti pubblicati (entrate = righe positive, uscite = righe negative)
const byMonth = new Map((stmts.data ?? []).map((s) => [s.period.slice(0, 7), s.statement_lines ?? []]));
const income = months.map((m) => (byMonth.get(m) ?? []).filter((l) => l.amount_ils > 0).reduce((a, l) => a + Number(l.amount_ils), 0));
const expenses = months.map((m) => -(byMonth.get(m) ?? []).filter((l) => l.amount_ils < 0).reduce((a, l) => a + Number(l.amount_ils), 0));
const net = months.map((_, i) => income[i] - expenses[i]);
const last = (stmts.data ?? []).at(-1);
const lastNet = last ? (last.statement_lines ?? []).reduce((a, l) => a + Number(l.amount_ils), 0) : null;
const rentOf = (p: (typeof properties)[number]) => p.leases?.find((l) => l.status === 'active');
---
<AppLayout title={t.nav.overview} active="overview">
  <h2 class="visually-hidden">{t.nav.overview}</h2>
  <div class="kpis">
    <div class="kpi">
      <p class="kpi-label"><Icon name="wallet" /> {fill(t.owner.kpiRent, { m: monthLong(curMonth, intl) })}</p>
      <p class="kpi-value"><Money v={rentReceived} /></p>
      <p class="kpi-sub ok">{fill(t.owner.kpiRentSub, { a: pays.data?.length ?? 0, b: activeLeases.length })}</p>
    </div>
    <div class="kpi">
      <p class="kpi-label"><Icon name="key" /> {t.owner.kpiOcc}</p>
      <p class="kpi-value">{new Intl.NumberFormat(intl, { style: 'percent' }).format(occupancy)}</p>
      <svg class="meter-svg" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true"><rect class="bg" width="100" height="6" rx="3" /><rect class="fg" width={Math.round(occupancy * 100)} height="6" rx="3" /></svg>
      <p class="kpi-sub">{fill(t.owner.kpiOccSub, { a: letCount, b: properties.length })}</p>
    </div>
    <div class="kpi">
      <p class="kpi-label"><Icon name="tool" /> {t.owner.kpiMaint}</p>
      <p class="kpi-value">{openReq}</p>
      <p class:list={['kpi-sub', { warn: waiting > 0 }]}><a href="/owner/maintenance">{fill(t.owner.kpiMaintSub, { n: waiting })}</a></p>
    </div>
    <div class="kpi kpi--accent">
      <p class="kpi-label"><Icon name="arrow" /> {t.owner.kpiNet}</p>
      <p class="kpi-value">{lastNet === null ? '—' : <Money v={lastNet} />}</p>
      <p class="kpi-sub">{last ? <a href={`/owner/statements/${last.id}`}>{fill(t.owner.kpiNetSub, { m: monthLong(last.period, intl) })}</a> : t.owner.noData}</p>
    </div>
  </div>

  <div class="charts">
    <IncomeChart months={months} income={income} expenses={expenses} />
    <CashflowChart months={months} net={net} />
  </div>

  <div class="grid-2">
    <SlaWidget />
    <ExpiriesWidget />
  </div>

  <div class="dcard">
    <div class="dcard-head"><strong>{t.owner.propertiesTitle}</strong><a href="/owner/properties" class="link-sm">{t.owner.seeAll} <Icon name="arrow" /></a></div>
    <ul class="prop-rows">
      {properties.map((p) => (
        <li>
          <span class="prop-ico" aria-hidden="true">{p.code.slice(0, 2)}</span>
          <span class="prop-name"><strong>{p.name}</strong><small>{p.address}, {p.city}</small></span>
          <span class={`pill pill--${p.status}`}>{(t.status as Record<string, string>)[p.status]}</span>
          <span class="prop-rent"><Money v={rentOf(p)?.monthly_rent_ils ?? p.asking_rent_ils ?? 0} /></span>
        </li>
      ))}
    </ul>
  </div>
</AppLayout>
