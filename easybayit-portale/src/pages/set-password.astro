---
// Impostazione nuova password (dopo invito o reset). Richiede sessione; se l'utente ha la 2FA,
// il middleware chiede prima il codice TOTP (il reset non scavalca la 2FA).
import AuthLayout from '../layouts/AuthLayout.astro';
import Field from '../components/Field.astro';
import Csrf from '../components/Csrf.astro';
import { password as pwSchema } from '../lib/validation';
import { logEvent } from '../lib/audit';
import { setFlash } from '../lib/flash';
import { homeFor } from '../lib/session';

const { t, supabase, user, profile } = Astro.locals;
let error = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const pw = String(fd.get('password') ?? '');
  const pw2 = String(fd.get('password2') ?? '');
  if (pw !== pw2) error = t.auth.mismatch;
  else if (!pwSchema.safeParse(pw).success) error = t.auth.weak;
  else {
    const { error: e } = await supabase.auth.updateUser({ password: pw });
    if (e) error = e.message.toLowerCase().includes('different') ? t.auth.weak : t.common.error;
    else {
      await logEvent(supabase, 'auth.password_changed', 'auth', user!.id);
      setFlash(Astro.cookies, 'success', t.auth.setDone);
      return Astro.redirect(homeFor(profile?.role), 303);
    }
  }
}
---
<AuthLayout title={t.auth.setTitle}>
  <h1>{t.auth.setTitle}</h1>
  <p class="sub">{t.auth.passwordRules}</p>
  {error && <p class="form-status" data-type="error" role="alert">{error}</p>}
  <form method="post">
    <Csrf />
    <input type="email" name="username" value={user?.email} autocomplete="username" hidden />
    <Field name="password" type="password" label={t.auth.newPassword} required autocomplete="new-password" maxlength={128} hint={t.auth.passwordRules} />
    <Field name="password2" type="password" label={t.auth.confirmPassword} required autocomplete="new-password" maxlength={128} />
    <button type="submit" class="btn btn--primary">{t.common.save}</button>
  </form>
</AuthLayout>
