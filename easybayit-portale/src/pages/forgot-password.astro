---
// Richiesta di reset password. Risposta sempre uguale (nessuna enumerazione degli account).
import AuthLayout from '../layouts/AuthLayout.astro';
import Field from '../components/Field.astro';
import Csrf from '../components/Csrf.astro';
import { email as emailSchema } from '../lib/validation';
import { hit } from '../lib/ratelimit';
import { SITE_URL } from 'astro:env/server';

const { t, supabase, ip } = Astro.locals;
let done = false;
let error = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const parsed = emailSchema.safeParse(fd.get('email'));
  if (!(await hit('forgot-ip', ip, 10, 900))) {
    error = t.auth.rateLimited;
    Astro.response.status = 429;
  } else {
    if (parsed.success && (await hit('forgot-email', parsed.data, 3, 3600))) {
      const { error: e } = await supabase.auth.resetPasswordForEmail(parsed.data, { redirectTo: `${SITE_URL}/set-password` });
      if (e) console.error('[forgot]', e.message);
    }
    done = true;
  }
}
---
<AuthLayout title={t.auth.forgotTitle}>
  <h1>{t.auth.forgotTitle}</h1>
  {done ? (
    <p class="form-status" data-type="success" role="status">{t.auth.forgotDone}</p>
  ) : (
    <>
      <p class="sub">{t.auth.forgotSub}</p>
      {error && <p class="form-status" data-type="error" role="alert">{error}</p>}
      <form method="post">
        <Csrf />
        <Field name="email" type="email" label={t.auth.email} required autocomplete="email" maxlength={320} />
        <button type="submit" class="btn btn--primary">{t.auth.sendLink}</button>
      </form>
    </>
  )}
  <p class="auth-links"><a href="/login">{t.auth.backToLogin}</a></p>
</AuthLayout>
