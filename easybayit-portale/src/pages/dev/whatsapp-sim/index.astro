---
// Simulatore WhatsApp (SOLO sviluppo): imita l'interfaccia di WhatsApp e invia al VERO webhook
// payload in formato Meta firmati con l'app secret locale. Nessun account Meta necessario.
import { botConfig } from '../../../lib/bot/config';
import { adminClient } from '../../../lib/supabase';
if (!botConfig.simulatorEnabled) return new Response('Not found', { status: 404 });
const { data: tenants } = await adminClient().from('tenants').select('full_name, phone, phone_digits').not('phone_digits', 'is', null).order('full_name');
const phones = [...(tenants ?? []).map((t) => ({ v: t.phone_digits!, l: `${t.full_name} · ${t.phone}` })), { v: '972509999999', l: 'Numero sconosciuto · +972 50-999-9999' }];
const csrf = Astro.locals.csrf;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>WhatsApp · simulatore locale Easybayit</title>
  <style is:global>
    :root { --wa-green: #008069; --wa-bg: #efeae2; --wa-out: #d9fdd3; --wa-in: #fff; --ink: #111b21; --muted: #667781; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 15px/1.4 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background: #d1d7db; color: var(--ink); min-height: 100vh; display: grid; place-items: center; }
    .phone { width: 420px; height: 860px; max-height: 96vh; background: var(--wa-bg); border-radius: 36px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.3); border: 10px solid #111; }
    header { background: var(--wa-green); color: #fff; padding: 14px 16px; display: flex; gap: 12px; align-items: center; }
    .avatar { width: 40px; height: 40px; border-radius: 50%; background: #fff; color: var(--wa-green); display: grid; place-items: center; font-weight: 800; }
    header small { display: block; opacity: .85; font-size: 12px; }
    .from { background: #f0f2f5; padding: 6px 10px; font-size: 12px; display: flex; gap: 6px; align-items: center; }
    .from select { flex: 1; font-size: 12px; padding: 4px; }
    #log { flex: 1; overflow-y: auto; padding: 12px 10px; display: flex; flex-direction: column; gap: 6px; }
    .msg { max-width: 82%; padding: 7px 10px 18px; border-radius: 8px; position: relative; white-space: pre-wrap; word-wrap: break-word; box-shadow: 0 1px .5px rgba(11,20,26,.13); }
    .msg.in { background: var(--wa-in); align-self: flex-start; border-top-left-radius: 0; }
    .msg.out { background: var(--wa-out); align-self: flex-end; border-top-right-radius: 0; }
    .msg time { position: absolute; right: 8px; bottom: 3px; font-size: 11px; color: var(--muted); }
    .msg img, .msg video { display: block; max-width: 240px; border-radius: 6px; margin-bottom: 4px; }
    .btns { display: flex; flex-direction: column; gap: 4px; align-self: flex-start; max-width: 82%; width: 82%; }
    .btns button { background: #fff; border: 0; border-radius: 8px; padding: 9px; color: #027eb5; font-weight: 600; cursor: pointer; box-shadow: 0 1px .5px rgba(11,20,26,.13); font-size: 14px; }
    .btns button:hover { background: #f5f6f6; }
    footer { display: flex; gap: 8px; padding: 8px; background: #f0f2f5; align-items: center; }
    footer input[type=text] { flex: 1; border: 0; border-radius: 20px; padding: 11px 14px; font-size: 15px; }
    .icon { width: 42px; height: 42px; border-radius: 50%; border: 0; background: var(--wa-green); color: #fff; font-size: 18px; cursor: pointer; display: grid; place-items: center; }
    .icon.clip { background: transparent; color: var(--muted); font-size: 22px; }
    .note { position: fixed; left: 16px; bottom: 12px; font-size: 12px; color: #3b4a54; max-width: 340px; }
    [rtl] { direction: rtl; text-align: right; }
  </style>
</head>
<body data-csrf={csrf}>
  <div class="phone" role="application" aria-label="Simulatore WhatsApp">
    <header><div class="avatar" aria-hidden="true">EB</div><div><strong>Easybayit Maintenance</strong><small>account aziendale · simulatore locale</small></div></header>
    <div class="from"><label for="from">Mittente:</label>
      <select id="from">{phones.map((p) => <option value={p.v}>{p.l}</option>)}</select></div>
    <div id="log" aria-live="polite"></div>
    <footer>
      <input type="file" id="file" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" hidden />
      <button class="icon clip" id="attach" type="button" aria-label="Allega foto o video">📎</button>
      <input type="text" id="text" placeholder="Scrivi un messaggio" autocomplete="off" aria-label="Messaggio" />
      <button class="icon" id="send" type="button" aria-label="Invia">➤</button>
    </footer>
  </div>
  <p class="note">Simulatore di sviluppo: i messaggi vengono inviati al webhook reale <code>/api/whatsapp/webhook</code> con firma HMAC come farebbe Meta. Disattivato in produzione.</p>
  <script>
    const csrf = document.body.dataset.csrf!;
    const log = document.getElementById('log')!;
    const from = document.getElementById('from') as HTMLSelectElement;
    const text = document.getElementById('text') as HTMLInputElement;
    const file = document.getElementById('file') as HTMLInputElement;
    let lastId = 0;
    const hdr = { 'x-csrf-token': csrf };
    const fmt = (iso: string) => new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const isRtl = (s: string) => /[\u0590-\u05FF]/.test(s);

    function render(m: any, last: boolean) {
      const d = document.createElement('div');
      d.className = `msg ${m.direction === 'in' ? 'out' : 'in'}`; // "in" per il bot = messaggio inviato dal telefono
      if (isRtl(m.body)) d.setAttribute('rtl', '');
      for (const md of m.media ?? []) {
        if (!md.url) continue;
        const el = md.mime.startsWith('video/') ? Object.assign(document.createElement('video'), { controls: true, muted: true }) : document.createElement('img');
        (el as HTMLImageElement).src = md.url; d.append(el);
      }
      if (m.body) d.append(document.createTextNode(m.body));
      const t = document.createElement('time'); t.textContent = fmt(m.created_at); d.append(t);
      log.append(d);
      if (m.direction === 'out' && m.buttons?.length && last) {
        const b = document.createElement('div'); b.className = 'btns';
        for (const x of m.buttons) {
          const btn = document.createElement('button'); btn.type = 'button'; btn.textContent = x.title; btn.dataset.id = x.id;
          btn.onclick = () => { b.remove(); send({ replyId: x.id, replyTitle: x.title }); };
          b.append(btn);
        }
        log.append(b);
      }
    }
    // un solo poll alla volta (send + intervallo) e niente doppioni per id
    let polling: Promise<void> | null = null;
    function poll(): Promise<void> {
      if (!polling) polling = doPoll().finally(() => { polling = null; });
      return polling;
    }
    async function doPoll() {
      const r = await fetch(`/dev/whatsapp-sim/messages?phone=${from.value}&after=${lastId}`);
      if (!r.ok) return;
      const { messages } = await r.json();
      const fresh = messages.filter((m: any) => m.id > lastId);
      if (!fresh.length) return;
      log.querySelectorAll('.btns').forEach((n) => n.remove());
      fresh.forEach((m: any, i: number) => render(m, i === fresh.length - 1));
      lastId = fresh[fresh.length - 1].id;
      log.scrollTop = log.scrollHeight;
    }
    async function send(body: Record<string, unknown>) {
      await fetch('/dev/whatsapp-sim/send', { method: 'POST', headers: { ...hdr, 'content-type': 'application/json' }, body: JSON.stringify({ from: from.value, ...body }) });
      await poll(); await poll();
    }
    document.getElementById('send')!.onclick = () => { const v = text.value.trim(); if (v) { text.value = ''; send({ text: v }); } };
    text.addEventListener('keydown', (e) => { if (e.key === 'Enter') document.getElementById('send')!.click(); });
    document.getElementById('attach')!.onclick = () => file.click();
    file.onchange = async () => {
      const f = file.files?.[0]; if (!f) return;
      const fd = new FormData(); fd.append('file', f); fd.append('_csrf', csrf);
      const r = await fetch('/dev/whatsapp-sim/media', { method: 'POST', headers: hdr, body: fd });
      file.value = '';
      if (r.ok) { const { id, mime } = await r.json(); await send({ media: { id, mime } }); }
    };
    from.onchange = () => { log.innerHTML = ''; lastId = 0; poll(); };
    poll(); setInterval(poll, 1500);
  </script>
</body>
</html>
