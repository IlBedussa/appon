---
// Grafico entrate/uscite (SVG generato lato server da dati reali) + tabella nascosta per screen reader.
import { money, monthShort, monthLong } from '../lib/format';
interface Props { months: string[]; income: number[]; expenses: number[] }
const { months, income, expenses } = Astro.props;
const { t, intl, currency, fx } = Astro.locals;
const W = 640, H = 260, PL = 60, PR = 12, PT = 16, PB = 30;
const plotW = W - PL - PR, plotH = H - PT - PB;
const maxV = Math.max(1000, ...income, ...expenses);
const step = niceStep(maxV / 4);
const yMax = step * 4;
const yTicks = [0, step, step * 2, step * 3, yMax];
const gw = plotW / Math.max(1, months.length);
const bw = gw * 0.3;
const y = (v: number) => PT + plotH - (v / yMax) * plotH;
function niceStep(raw: number) {
  const p = Math.pow(10, Math.floor(Math.log10(raw)));
  const n = raw / p;
  return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * p;
}
const fmt = (v: number, compact = false) => money(v, intl, currency, fx, { compact });
---
<figure class="dcard chart">
  <figcaption class="dcard-head">
    <span><strong>{t.owner.chartIe}</strong><small>{t.owner.chartIeSub}</small></span>
    <span class="legend"><i class="lg-inc"></i>{t.owner.income} <i class="lg-exp"></i>{t.owner.expenses}</span>
  </figcaption>
  <div class="chart-wrap" dir="ltr">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t.owner.chartSummary}>
      {yTicks.map((v) => (
        <g>
          <line x1={PL} x2={W - PR} y1={y(v)} y2={y(v)} class="grid-line" />
          <text x={PL - 8} y={y(v) + 4} text-anchor="end" class="axis">{fmt(v, true)}</text>
        </g>
      ))}
      {months.map((m, i) => (
        <g class="bar-group">
          <title>{monthLong(m, intl)}: {t.owner.income} {fmt(income[i])} · {t.owner.expenses} {fmt(expenses[i])}</title>
          <rect class="bar bar-inc" x={PL + gw * i + gw / 2 - bw - 1} y={y(income[i])} width={bw} height={Math.max(0, plotH + PT - y(income[i]))} rx="3" />
          <rect class="bar bar-exp" x={PL + gw * i + gw / 2 + 1} y={y(expenses[i])} width={bw} height={Math.max(0, plotH + PT - y(expenses[i]))} rx="3" />
          <text x={PL + gw * i + gw / 2} y={H - 10} text-anchor="middle" class="axis">{monthShort(m, intl)}</text>
        </g>
      ))}
    </svg>
  </div>
  <table class="visually-hidden">
    <caption>{t.owner.chartIe}</caption>
    <thead><tr><th scope="col">{t.st.period}</th><th scope="col">{t.owner.income}</th><th scope="col">{t.owner.expenses}</th></tr></thead>
    <tbody>{months.map((m, i) => <tr><th scope="row">{monthLong(m, intl)}</th><td>{fmt(income[i])}</td><td>{fmt(expenses[i])}</td></tr>)}</tbody>
  </table>
</figure>
