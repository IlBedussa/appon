---
// Flusso di cassa netto cumulato (SVG lato server).
import { money, monthShort, monthLong } from '../lib/format';
interface Props { months: string[]; net: number[] }
const { months, net } = Astro.props;
const { t, intl, currency, fx } = Astro.locals;
const cum = net.reduce<number[]>((a, v) => [...a, (a.at(-1) ?? 0) + v], []);
const W = 640, H = 260, PL = 60, PR = 12, PT = 16, PB = 30;
const plotW = W - PL - PR, plotH = H - PT - PB;
const minV = Math.min(0, ...cum), maxV = Math.max(1000, ...cum);
const span = maxV - minV;
const ticks = [0, 1, 2, 3, 4].map((i) => minV + (span * i) / 4);
const gw = plotW / Math.max(1, months.length);
const cy = (v: number) => PT + plotH - ((v - minV) / span) * plotH;
const cx = (i: number) => PL + gw * i + gw / 2;
const linePath = cum.map((v, i) => `${i ? 'L' : 'M'}${cx(i).toFixed(1)},${cy(v).toFixed(1)}`).join(' ');
const areaPath = cum.length ? `${linePath} L${cx(cum.length - 1).toFixed(1)},${cy(minV)} L${cx(0).toFixed(1)},${cy(minV)} Z` : '';
const fmt = (v: number, compact = false) => money(v, intl, currency, fx, { compact });
---
<figure class="dcard chart">
  <figcaption class="dcard-head">
    <span><strong>{t.owner.chartCf}</strong><small>{t.owner.chartCfSub}</small></span>
    <span class="cf-total">{fmt(cum.at(-1) ?? 0)}</span>
  </figcaption>
  <div class="chart-wrap" dir="ltr">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.owner.chartCf}: ${fmt(cum.at(-1) ?? 0)}`}>
      <defs>
        <linearGradient id="cfg" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" class="cf-stop1" /><stop offset="100%" class="cf-stop2" /></linearGradient>
      </defs>
      {ticks.map((v) => (
        <g><line x1={PL} x2={W - PR} y1={cy(v)} y2={cy(v)} class="grid-line" /><text x={PL - 8} y={cy(v) + 4} text-anchor="end" class="axis">{fmt(v, true)}</text></g>
      ))}
      {areaPath && <path d={areaPath} fill="url(#cfg)" class="cf-area" />}
      {linePath && <path d={linePath} class="cf-line" pathLength="1" />}
      {cum.map((v, i) => (
        <g>
          <circle cx={cx(i)} cy={cy(v)} r="4" class="cf-dot"><title>{monthLong(months[i], intl)}: {fmt(v)}</title></circle>
          <text x={cx(i)} y={H - 10} text-anchor="middle" class="axis">{monthShort(months[i], intl)}</text>
        </g>
      ))}
    </svg>
  </div>
</figure>
