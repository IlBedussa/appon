# =============================================================================
# Easybayit Portal – variabili d'ambiente (SOLO NOMI E SCOPO, nessun valore reale)
# Copiare in .env (gitignored). In produzione impostarle su Vercel > Settings > Environment Variables.
# =============================================================================

# URL pubblico del portale (usato nei link delle email). Es.: https://portal.<dominio>
SITE_URL=http://localhost:4322

# Supabase: URL del progetto e chiavi (Dashboard > Project Settings > API).
# In locale: output di `supabase status`.
SUPABASE_URL=
# Chiave pubblica "anon"/publishable: le query dell'utente passano da RLS
SUPABASE_ANON_KEY=
# Chiave "service_role"/secret: SOLO server (inviti, coda email, rate limit). Mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cookie con flag Secure (true in produzione; i browser lo accettano anche su http://localhost)
COOKIE_SECURE=true

# Email: smtp (locale: Mailpit di Supabase su 127.0.0.1:54325) | resend (produzione) | console
EMAIL_PROVIDER=smtp
EMAIL_FROM=Easybayit <no-reply@example.invalid>
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
# Solo se EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Segreto per gli endpoint /api/cron/outbox e /api/cron/reminders (Vercel Cron invia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Segreto per il codice di integrità stampato sui PDF dei rendiconti (stringa casuale lunga)
PDF_INTEGRITY_SECRET=

# API ufficiale Banca d'Israele per i cambi (default già corretto)
# BOI_API_URL=

# Tentativi di login per email ogni 15 minuti
LOGIN_MAX_ATTEMPTS=5

# Solo per script di seed/test (non usate dall'app)
SUPABASE_DB_URL=

# ---- Bot manutenzione WhatsApp / web chat (in sviluppo) ----
# cloud | simulator | disabled
WHATSAPP_PROVIDER=
# Meta WhatsApp Cloud API (solo con WHATSAPP_PROVIDER=cloud)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret Meta: verifica firma X-Hub-Signature-256 del webhook
WHATSAPP_APP_SECRET=
# Token scelto da noi per la verifica GET del webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
# true per abilitare /dev/whatsapp-sim fuori dalla modalità sviluppo (mai in produzione)
WHATSAPP_SIMULATOR=
# Numero di emergenza mostrato dal bot
BOT_EMERGENCY_PHONE=
# rules | llm
NLU_PROVIDER=
