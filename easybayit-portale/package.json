{
  "name": "easybayit-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4322 --host 127.0.0.1",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "db:start": "supabase start -x vector,logflare,supavisor,realtime,edge-runtime,imgproxy,postgres-meta,studio",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run seed",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls.test.ts",
    "screenshots": "node --env-file=.env scripts/screenshots.mjs",
    "test:unit": "vitest run tests/unit.test.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "totp": "node scripts/totp.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/vercel": "11.0.11",
    "@fontsource/heebo": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "astro": "7.3.5",
    "nodemailer": "10.0.13",
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
